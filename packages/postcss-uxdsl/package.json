{
  "name": "postcss-uxdsl",
  "version": "0.1.2",
  "description": "PostCSS plugin for UXDSL - a lightweight CSS DSL for design systems",
  "main": "dist/index.js",
  "keywords": [
    "postcss",
    "plugin",
    "css",
    "dsl",
    "uxdsl",
    "design-system"
  ],
  "author": "Ricardo Santoyo <rsantoyo-dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsantoyo-dev/uxdsl.git",
    "directory": "packages/postcss-uxdsl"
  },
  "bugs": {
    "url": "https://github.com/rsantoyo-dev/uxdsl/issues"
  },
  "homepage": "https://github.com/rsantoyo-dev/uxdsl#readme",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "require": "./dist/runtime.js",
      "import": "./dist/runtime.mjs"
    },
    "./theme/*": "./src/theme/*"
  },
  "dependencies": {
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3"
  }
}
