{
  "name": "postcss-uxdsl",
  "version": "0.1.3",
  "description": "PostCSS plugin for UXDSL - a lightweight CSS DSL for design systems",
  "main": "dist/index.js",
  "keywords": [
    "UX-DSL",
    "PostCSS",
    "Plugin",
    "CSS Preprocessor",
    "Design System",
    "CSS",
    "TypeScript",
    "UX",
    "Design Tokens",
    "Compiler",
    "Style",
    "Theme",
    "UI/UX",
    "SCSS",
    "Clean Code",
    "Separation of Concerns",
    "DSL",
    "Frontend",
    "Web Development"
  ],
  "author": "Ricardo Santoyo <rsantoyo-dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsantoyo-dev/uxdsl.git",
    "directory": "packages/postcss-uxdsl"
  },
  "bugs": {
    "url": "https://github.com/rsantoyo-dev/uxdsl/issues"
  },
  "homepage": "https://github.com/rsantoyo-dev/uxdsl#readme",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ds-runtime": {
      "require": "./dist/ds-runtime.js",
      "import": "./dist/ds-runtime.js",
      "types": "./dist/ds-runtime.d.ts"
    },
    "./theme/*": "./src/theme/*"
  },
  "dependencies": {
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3"
  }
}
