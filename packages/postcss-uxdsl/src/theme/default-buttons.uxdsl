/* Generated by scripts/generate-language-artifacts.js. Do not edit.
 * Deprecated (FEAT-008, MIG-B6-29): every built-in preset already reads
 * these defaults from postcss-uxdsl/theme/base.json directly, with no
 * import needed. Kept, unchanged in meaning, for a project that already
 * imports this pack explicitly. Not removed in 0.5.0-beta.6. */
@theme {
  button-contained: {
    @ds-surface(contained);
    :hover {
      bg: var(--uxdsl__button__tone-dark, var(--uxdsl__palette__primary-dark));
      color: var(--uxdsl__button__tone-contrast, var(--uxdsl__palette__primary-contrast));
    }
    :selected {
      bg: var(--uxdsl__button__tone-dark, var(--uxdsl__palette__primary-dark));
      color: var(--uxdsl__button__tone-contrast, var(--uxdsl__palette__primary-contrast));
    }
  }
  button-outlined: {
    @ds-surface(outlined);
    :hover {
      color: var(--uxdsl__button__tone-dark, var(--uxdsl__palette__primary-dark));
      border: 1px solid var(--uxdsl__button__tone-dark, var(--uxdsl__palette__primary-dark));
    }
    :selected {
      bg: var(--uxdsl__button__tone-main, var(--uxdsl__palette__primary-main));
      color: var(--uxdsl__button__tone-contrast, var(--uxdsl__palette__primary-contrast));
      border: 1px solid var(--uxdsl__button__tone-main, var(--uxdsl__palette__primary-main));
    }
  }
  button-flat: {
    @ds-surface(flat);
    :hover {
      color: var(--uxdsl__button__tone-dark, var(--uxdsl__palette__primary-dark));
    }
    :selected {
      color: var(--uxdsl__button__tone-dark, var(--uxdsl__palette__primary-dark));
    }
  }
}
