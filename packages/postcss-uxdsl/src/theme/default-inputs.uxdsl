/* Generated by scripts/generate-language-artifacts.js. Do not edit. */
@theme {
  input-contained: {
    @ds-surface(contained);
    caret: var(--input-tone-main, var(--ds__palette__primary-main));
    placeholder: palette(neutral.dark);
    :focus {
      border: 1px solid var(--input-tone-main, var(--ds__palette__primary-main));
      shadow: shadow(2);
    }
    :invalid {
      border: 1px solid palette(error.main);
    }
    :disabled {
      color: palette(neutral.dark);
      opacity: 0.6;
    }
  }
  input-outlined: {
    @ds-surface(outlined);
    caret: var(--input-tone-main, var(--ds__palette__primary-main));
    placeholder: palette(neutral.dark);
    :focus {
      border: 1px solid var(--input-tone-main, var(--ds__palette__primary-main));
    }
    :invalid {
      border: 1px solid palette(error.main);
    }
    :disabled {
      opacity: 0.6;
    }
  }
  input-underline: {
    @ds-surface(flat);
    border: none;
    shadow: none;
    underline: 1px solid palette(neutral.dark);
    caret: var(--input-tone-main, var(--ds__palette__primary-main));
    placeholder: palette(neutral.dark);
    :focus {
      underline: 1px solid var(--input-tone-main, var(--ds__palette__primary-main));
    }
    :invalid {
      underline: 1px solid palette(error.main);
    }
    :disabled {
      opacity: 0.6;
    }
  }
}
