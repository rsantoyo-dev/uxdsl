/* Generated by scripts/generate-language-artifacts.js. Do not edit.
 * Deprecated (FEAT-008, MIG-B6-29): every built-in preset already reads
 * these defaults from postcss-uxdsl/theme/base.json directly, with no
 * import needed. Kept, unchanged in meaning, for a project that already
 * imports this pack explicitly. Not removed in 0.5.0-beta.6. */
@theme {
  input-contained: {
    @ds-surface(contained);
    caret: tone(main);
    placeholder: palette(neutral.dark);
    :focus {
      border: 1px solid tone(main);
      shadow: shadow(2);
    }
    :invalid {
      border: 1px solid palette(error.main);
    }
    :disabled {
      color: palette(neutral.dark);
      opacity: 0.6;
      cursor: not-allowed;
    }
  }
  input-outlined: {
    @ds-surface(outlined);
    caret: tone(main);
    placeholder: palette(neutral.dark);
    :focus {
      border: 1px solid tone(main);
    }
    :invalid {
      border: 1px solid palette(error.main);
    }
    :disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }
  input-underline: {
    @ds-surface(flat);
    border: none;
    shadow: none;
    underline: 1px solid palette(neutral.dark);
    caret: tone(main);
    placeholder: palette(neutral.dark);
    :focus {
      underline: 1px solid tone(main);
    }
    :invalid {
      underline: 1px solid palette(error.main);
    }
    :disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }
}
