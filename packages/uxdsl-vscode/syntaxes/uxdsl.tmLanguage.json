{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UXDSL",
  "scopeName": "source.uxdsl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#functions"
    },
    {
      "include": "source.css"
    }
  ],
  "injections": {
    "L:meta.at-rule.media.header.css": {
      "patterns": [
        {
          "include": "#breakpointMedia"
        }
      ]
    },
    "L:meta.property-list.css -meta.property-value.css -comment -string": {
      "patterns": [
        {
          "name": "meta.at-rule.media.header.uxdsl",
          "begin": "(?i)(?<![\\w-])@media\\b",
          "end": "(?=\\s*[{;])",
          "patterns": [
            {
              "include": "#breakpointMedia"
            }
          ]
        }
      ]
    }
  },
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.uxdsl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uxdsl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.uxdsl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.at-rule.uxdsl",
          "match": "@(ds-surface|ds-typo|ds-button|ds-input)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(palette|color|radius|border|density|shadow|space|xs|sm|md|lg|xl)\\s*(?=\\()",
          "name": "support.function.uxdsl"
        }
      ]
    },
    "breakpointMedia": {
      "patterns": [
        {
          "name": "meta.media-feature.breakpoint.uxdsl",
          "match": "\\(\\s*(--(?i:sm|md|lg|xl))\\s*\\)",
          "captures": {
            "1": {
              "name": "support.constant.breakpoint.uxdsl"
            }
          }
        }
      ]
    }
  }
}
