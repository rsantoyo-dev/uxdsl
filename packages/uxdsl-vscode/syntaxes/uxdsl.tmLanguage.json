{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UXDSL",
  "scopeName": "source.uxdsl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#functions"
    },
    {
      "include": "source.css"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.uxdsl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uxdsl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.uxdsl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.at-rule.uxdsl",
          "match": "@(theme|ds-surface|ds-typo|ds-button|ds-input)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(palette|color|radius|rounded|border|density|shadow|elevation|space|xs|sm|md|lg|xl)\\s*(?=\\()",
          "name": "support.function.uxdsl"
        }
      ]
    }
  }
}
