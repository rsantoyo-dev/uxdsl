{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "ds-button",
          "ds-surface",
          "ds-typo",
          "ds-input",
          "theme"
        ]
      }
    ],
    "scss/dollar-variable-pattern": null,
    "scss/at-import-partial-extension": null,
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": [
          "/^--/"
        ]
      }
    ]
  }
}