/* DemoColors styles - Scoped */
#DemoColors {
  .demo-section { display: flex; flex-direction: column; gap: density(3); }
  .demo-header { display: flex; flex-direction: column; gap: density(2); }
  .demo-title { @ds-typo (h4); margin: 0; }
  .demo-subtitle { @ds-typo (body); max-width: 720px; }

  .colors-stack { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: density(4); }
  .color-family { display: flex; flex-direction: column; gap: density(2); }
  .family-title { @ds-typo (h5); margin: 0; text-transform: capitalize; }

  .family-grid { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: density(1); }

  .color-token { 
    border-radius: radius(1); 
    padding: density(1); 
    background: palette(surface-main, 0.2); 
    display: flex; 
    flex-direction: column; 
    justify-content: center; 
    align-items: center; 
    position: relative; 
    height: density(8); 
    min-width: 0; 
    transition: transform 0.2s ease, box-shadow 0.2s ease; 
  }

  .color-token:hover { transform: scale(1.05); z-index: 1; box-shadow: shadow(2); }

  .token-shade { @ds-typo (caption); font-weight: bold; opacity: 0.9; pointer-events: none; }
  .token-values { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; position: absolute; bottom: density(1); right: density(1); pointer-events: none; }
  .token-hex { @ds-typo (caption); font-family: monospace; font-weight: bold; font-size: 0.75em; }
  .token-rgb { @ds-typo (tag); font-family: monospace; opacity: 0.7; font-size: 0.65em; }

  /* Interactive Playground */
  .surfaces-playground-container {
    display: flex;
    flex-direction: column;
    gap: density(2);
  }

  .surface-playground {
    display: flex;
    flex-direction: column;
    gap: density(3);
    @ds-surface(outlined);
    padding: density(3);
    background: palette(surface-light, 0.3);
  }

  @media (min-width: 768px) {
    .surface-playground {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .surface-playground__controls {
    display: flex;
    flex-direction: column;
    gap: density(2);
    min-width: 250px;
  }

  .surface-playground__controls label {
    display: flex;
    flex-direction: column;
    gap: density(1);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .surface-playground__controls select {
    @ds-input(outlined neutral);
    padding: density(1);
  }

  .surface-playground__preview {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: density(2);
  }

  .demo-code-block {
    @ds-surface(outlined);
    border-radius: radius(2);
    overflow: hidden;
  }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: density(1) density(2);
    background: palette(neutral-dark);
    color: palette(neutral-contrast);
  }

  .code-file {
    @ds-typo(caption);
    opacity: 0.8;
  }

  $color-families: blue, indigo, purple, pink, red, orange, yellow, green, teal, cyan, gray;
  $color-shades: 50, 100, 200, 300, 400, 500, 600, 700, 800, 900;

  @each $family in $color-families {
    @each $shade in $color-shades {
      .chip--#{$family}-#{$shade} {
        background: color(#{$family}-#{$shade});
      }
    }
  }
}