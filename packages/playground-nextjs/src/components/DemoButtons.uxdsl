/* Demo layout only. Button visuals and states come from the shared engine. */
#DemoButtons {
  background: transparent;
  .section { margin-block: density(3); }
  .surfaces-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: density(3);
    margin-block: density(3);
  }
  pre { overflow-x: auto; }
  label { margin-inline-end: density(2); }
}
