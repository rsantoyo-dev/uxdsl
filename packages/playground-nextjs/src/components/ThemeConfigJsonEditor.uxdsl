/* The JSON tab of the Live theme handler (/docs/theme): the theme as a JSON tree
   (vanilla-jsoneditor). Every value is a UXDSL token, role or directive; the literals left
   are layout (flex) and sizes the editor needs. */

.config-editor__toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: density(3);
}

.config-editor__hint {
  @ds-typo(caption);

  color: palette(text.secondary);
}

.config-editor__buttons {
  display: flex;
  gap: density(2);
}

.config-editor__button {
  @ds-button(outlined 2);
  @ds-typo(body-sm);

  display: inline-flex;
  align-items: center;
  gap: density(2);
}

.config-editor__button--primary {
  @ds-button(contained primary 2);
}

.config-editor {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

/* The editor draws itself with --jse-* custom properties; here each one is a Palette role,
   so the tree follows the palette and dark mode like the rest of the page: the theme's
   modes.dark.palette redefines the roles, and this rule never names a mode. */
.config-editor__tree {
  --jse-theme-color: palette(primary.main);
  --jse-theme-color-highlight: palette(primary.dark);
  --jse-background-color: palette(surface.main);
  --jse-text-color: palette(text.primary);
  --jse-text-color-inverse: palette(text.secondary);
  --jse-main-border: border(1);
  --jse-menu-color: palette(primary.contrast);
  --jse-panel-background: palette(surface.light);
  --jse-panel-color: palette(text.primary);
  --jse-panel-color-readonly: palette(text.disabled);
  --jse-panel-border: border(1);
  --jse-panel-background-border: border(1);
  --jse-hover-background-color: palette(surface.light);
  --jse-active-line-background-color: palette(surface.light);
  --jse-selection-background-color: palette(primary.light, 0.25);
  --jse-selection-background-inactive-color: palette(neutral.light, 0.4);
  --jse-key-color: palette(primary.main);
  --jse-value-color: palette(text.primary);
  --jse-value-color-string: palette(success.main);
  --jse-value-color-number: palette(info.main);
  --jse-value-color-boolean: palette(warning.main);
  --jse-value-color-null: palette(text.secondary);
  --jse-delimiter-color: palette(text.secondary);
  --jse-collapsed-items-background-color: palette(surface.light);
  --jse-collapsed-items-link-color: palette(primary.main);
  --jse-tag-background: palette(surface.light);
  --jse-tag-color: palette(text.secondary);
  --jse-input-background: palette(surface.main);
  --jse-input-border: border(1);
  --jse-button-background: palette(primary.main);
  --jse-button-color: palette(primary.contrast);
  --jse-context-menu-background: palette(surface.main);
  --jse-context-menu-color: palette(text.primary);
  --jse-modal-background: palette(surface.main);
  --jse-error-color: palette(error.main);
  --jse-font-family-mono: var(--uxdsl__font__code, monospace);
  --jse-font-size-mono: space(4);

  height: calc(space(16) * 2);
  resize: vertical;
  overflow: hidden;
  border-radius: radius(1);

  &.is-invalid {
    outline: space(1) solid palette(error.main);
  }
}

.config-editor__status {
  @ds-typo(caption);

  color: palette(text.secondary);

  &.is-invalid {
    color: palette(error.main);
  }
}
