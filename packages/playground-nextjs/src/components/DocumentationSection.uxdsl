/* The prose of every documentation page, and the disclosure the demos put their long token
   grids behind. Shared by many components, so it stays in the global sheet. The code panel
   is a Color identity, dark in both modes on purpose. */

.doc-section {
  min-width: 0;
  margin-block: space(7);
  line-height: 1.7;
}

.doc-section h2 {
  @ds-typo(h4);
  margin-block: space(7) space(4);
}

.doc-section h3 {
  @ds-typo(h5);
  margin-block: space(6) space(3);
}

.doc-section h4 {
  margin-bottom: space(4);
}

.doc-section p {
  margin-block: space(4);
}

.doc-section ul, .doc-section ol {
  padding-inline-start: space(6);
}

.doc-section li {
  margin-block: space(2);
}

.doc-section pre {
  overflow-x: auto;
  max-width: 100%;
  background: color(gray.900);
  color: color(gray.200);
  padding: space(5);
  border-radius: radius(2);
  font-size: 0.85rem;
}

.doc-section :not(pre) > code {
  overflow-wrap: anywhere;
}

.doc-section a {
  color: palette(primary.main);
  text-underline-offset: 2px;

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
    border-radius: radius(1);
  }
}

.doc-section__table-wrap {
  overflow-x: auto;
  margin-block: space(5);
}

.doc-section__table-wrap table {
  width: 100%;
  text-align: left;
  border-collapse: collapse;
}

.doc-section__table-wrap caption {
  text-align: left;
  font-weight: 600;
  margin-bottom: space(3);
}

.doc-section__table-wrap th, .doc-section__table-wrap td {
  padding: space(3) space(4);
  border-bottom: border(1);
  vertical-align: top;
}

.demo-disclosure {
  margin-block: density(4);
  border: border(1);
  border-radius: radius(2);
  padding: density(2) density(3);
  min-width: 0;
}

.demo-disclosure__summary {
  @ds-typo(h6);
  margin: 0;
  cursor: pointer;
  border-radius: radius(1);

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}
