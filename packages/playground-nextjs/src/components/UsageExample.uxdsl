/* The "Use it in your project" block that ends every part of the Live theme handler
   (UsageExample.tsx). Every value is a UXDSL token, role or directive; the literals left are
   layout (grid, flex) and the code block's whitespace. */

.use {
  display: flex;
  flex-direction: column;
  gap: density(3);
  margin-top: density(4);
  padding-top: density(4);
  border-top: border(1);
}

.use__title {
  @ds-typo(subtitle2);

  margin: density(0);
  color: palette(text.primary);
}

.use__note {
  @ds-typo(body-sm);

  margin: density(0);
  color: palette(text.secondary);
}

.use__pair {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) lg(minmax(0, 1fr) minmax(0, 1fr));
  align-items: start;
  gap: density(3);
}

.use__live {
  @ds-surface(outlined radius(3));

  display: flex;
  flex-direction: column;
  gap: density(3);
}

.use__live-title {
  @ds-typo(caption);

  color: palette(text.secondary);
}

.use__results {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: density(4);
}

.use__result {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: density(2);
  margin: density(0);
  min-width: 0;
}

.use__result-box {
  display: flex;
  align-items: center;
}

/* A layout example takes the whole row, so its own width is what changes. */
.use__result--wide {
  flex: 1 1 100%;
  align-items: stretch;

  .use__result-box > * {
    flex: 1;
  }
}

.use__result-label {
  @ds-typo(code);

  color: palette(primary.main);
}

/* The boxes the examples style: a plain element for a token to act on. */
.usx-box {
  @ds-typo(body-sm);

  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: space(14);
  min-height: space(10);
  padding: density(2);
}

.usx-box--card {
  background: palette(surface.main);
  color: palette(text.primary);
}

.usx-box--fill {
  background: palette(primary.main);
  color: palette(primary.contrast);
}

.usx-box--line {
  min-height: space(2);
  padding: density(0);
}

/* The example's local exception: a longhand after the shared border. */
.use .usx-dashed {
  border-style: dashed;
}

.use__blocks {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, calc(space(16) * 1.5)), 1fr));
  gap: density(3);
}

.use__block {
  display: flex;
  flex-direction: column;
  gap: density(1);
  min-width: 0;
  margin: density(0);
}

.use__label {
  @ds-typo(caption);

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: density(2);
  color: palette(text.secondary);
}

.use__copy {
  @ds-button(flat 1);
  @ds-typo(caption);

  display: inline-flex;
  align-items: center;
  gap: density(1);
}

.use__code {
  @ds-typo(code);

  margin: density(0);
  padding: density(3);
  max-height: calc(space(16) * 1.5);
  overflow: auto;
  white-space: pre;
  border-radius: radius(2);
  background: palette(surface.light);
  color: palette(text.primary);
  border: border(1);
}
