/* Simplified DemoPalette styles */

.palette-section { display: flex; flex-direction: column; gap: density(2); }
.palette-header { display: flex; flex-direction: column; gap: density(2); }
.demo-title { @ds-typo (h4); margin: 0; }
.demo-subtitle { @ds-typo (body); opacity: 0.75; margin: 0; max-width: 720px; }

.palette-stack { display: flex; flex-direction: column; gap: density(2); }
.palette-card { @ds-surface (contained surface); display: flex; flex-direction: column; gap: density(1); transition: transform 150ms ease, box-shadow 150ms ease; }
.palette-card:hover { transform: translateY(-2px); box-shadow: shadow(2); }
.palette-card__header { display: flex; flex-direction: column; gap: density(2); }
.palette-card__title { @ds-typo (h5); margin: 0; }
.palette-card__detail { @ds-typo (body); margin: 0; opacity: 0.85; }

.palette-token-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: row; flex-wrap: wrap; gap: density(2); align-items: stretch; }
.palette-token { border-radius: radius(1); padding: density(1); background: palette(surface-main, 0.2); display: flex; flex-direction: column; gap: density(1); flex: 1 1 180px; min-width: 180px; }
.token-label { @ds-typo (caption); opacity: 0.8; }
.token-helper { @ds-typo (caption); opacity: 0.9; }
.token-css { @ds-typo (tag); opacity: 0.75; }

@mixin palette-card($tone, $variant, $set-text: false) {
  .palette-card-#{$tone}-#{$variant} {
    @ds-surface($tone, 1);
    background: palette(#{$tone}-#{$variant});
    box-shadow: shadow(1);

    @if $set-text == true {
      color: palette(#{$tone}-dark);
    }
  }
}
$tones: primary, secondary, tertiary, success, info, warning, error, dark, neutral, light, surface;
$variants: main, light, dark;

// MAIN + LIGHT + DARK
@each $tone in $tones {
  @each $variant in $variants {
    @include palette-card($tone, $variant);
  }

  // CONTRAST variant (with text color)
  @include palette-card($tone, contrast, true);
}