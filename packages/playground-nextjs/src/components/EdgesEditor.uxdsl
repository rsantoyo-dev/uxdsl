/* The Borders / Radii editor of the Live theme handler (/docs/theme). Every value is a UXDSL
   token, role or directive; the literals left are layout (grid, flex). */

/* One class per token of the base theme, so every box is border(n) or radius(n) itself. */
@for $n from 0 through 5 {
  .ede-border--#{$n} {
    border: border(#{$n});
  }

  .ede-radius--#{$n} {
    border-radius: radius(#{$n});
  }

  /* The chosen token on real components, after their directive. */
  .ede__samples .ede-b--#{$n} {
    border: border(#{$n});
  }

  .ede__samples .ede-r--#{$n} {
    border-radius: radius(#{$n});
  }
}

.ede__toolbar {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.ede__kinds {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
}

.ede__kind {
  @ds-button(outlined 1);
}

.ede__hint,
.ede__note,
.ede__as-written,
.ede__px {
  @ds-typo(caption);

  color: palette(text.secondary);
}

.ede {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) lg(minmax(0, 3fr) minmax(0, 2fr));
  gap: density(4);
}

.ede__preview,
.ede__editor {
  display: flex;
  flex-direction: column;
  gap: density(3);
  min-width: 0;
}

/* Every token of the family, live. */
.ede__gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(space(14), 1fr));
  gap: density(2);
}

.ede__tile {
  @ds-button(flat 2);

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: density(2);

  /* Not border(n): the tokens on show are the ones being edited. */
  &.is-selected {
    background: palette(surface.light);
    color: palette(primary.main);
  }
}

.ede__box {
  width: space(13);
  height: space(12);
  background: palette(surface.main);
}

/* A Radius shows on a filled shape; a Border on a lighter one (so border(0), none, still shows), with the theme's middle corner. */
.ede__box--radii {
  background: palette(primary.main);
}

.ede__box--borders {
  border-radius: radius(2);
  background: palette(surface.light);
}

.ede__tile-name,
.ede__bp,
.ede__written {
  @ds-typo(code);
}

.ede__stage {
  @ds-surface(outlined radius(3));

  display: flex;
  flex-direction: column;
  gap: density(3);
}

.ede__stage-label {
  @ds-typo(code);

  color: palette(primary.main);
}

.ede__samples {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) md(minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr));
  align-items: center;
  gap: density(3);
}

.ede__card {
  @ds-surface(contained);

  display: flex;
  flex-direction: column;
  gap: density(1);
}

.ede__card-title {
  @ds-typo(code);
}

.ede__card-text {
  @ds-typo(body-sm);
}

.ede__button {
  @ds-button(contained primary 2);
}

.ede__input {
  @ds-input(outlined);
}

/* The value per breakpoint. */
.ede__rows {
  @ds-surface(outlined radius(2));

  display: flex;
  flex-direction: column;
  gap: density(1);
}

.ede__row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(2);
  padding: density(1);
  border-radius: radius(1);

  &.is-active {
    background: palette(surface.light);
  }
}

.ede__row .ede__bp {
  flex: 0 0 space(9);
}

.ede__row .ede__px {
  flex: 0 0 auto;
}

.ede__as-written {
  flex: 1 1 space(15);
}

.ede__select {
  @ds-input(outlined);
  @ds-typo(body-sm);

  flex: 1 1 space(12);
  width: auto;
  min-width: 0;
}

.ede__title {
  @ds-typo(subtitle2);
}

.ede__definition {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.ede__text {
  @ds-input(outlined);
  @ds-typo(code);
}

.ede__error {
  @ds-typo(caption);

  color: palette(error.main);
}

.ede__consumers {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.ede__list {
  @ds-typo(body-sm);

  display: flex;
  flex-direction: column;
  gap: density(0);
  margin: density(0);
  padding-inline-start: density(4);
}
