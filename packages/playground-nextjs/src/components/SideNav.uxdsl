/* SideNav Styles - JS Driven Responsiveness */

/* Burger Button */
.side-nav__burger {
  @ds-button(outlined);
  
  display: flex; /* Mobile default */
  align-items: center;
  justify-content: center;
  padding: density(2);
  margin-bottom: space(2);
  width: fit-content;

  /* Hide on desktop */
  .side-nav--desktop & {
    display: none;
  }
}

/* Backdrop */
.side-nav__backdrop {
  display: block; /* Mobile default */
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 99;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.15s ease;

  &.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Hide on desktop */
  .side-nav--desktop & {
    display: none;
  }
}

/* Menu Container */
.side-nav__menu {
  /* Mobile Defaults (Drawer) */
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 280px;
  z-index: 100;
  transform: translateX(-100%);
  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  
  /* Shared Styles */
  background: palette(surface-main);
  
  /* Mobile Styles */
  border-right: border(1, palette(neutral-dark, 0.1));
  box-shadow: shadow(3);
  padding: space(4);
  height: 100%;
  overflow-y: auto;

  &.is-open {
    transform: translateX(0);
  }

  /* Desktop Overrides (Sidebar) */
  .side-nav--desktop & {
    position: static;
    width: auto;
    z-index: auto;
    transform: none;
    
    /* Desktop Styles */
    padding: density(3);
    height: auto;
    overflow-y: visible;
    
    @ds-surface(flat);
    background: palette(surface-main); /* Ensure opaque */
    
    border: border(1);
    border-radius: radius(2);
    box-shadow: none;
  }
}

/* Header (Mobile Only) */
.side-nav__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: space(4);

  .side-nav--desktop & {
    display: none;
  }
}

.side-nav__title {
  @ds-typo(h5);
  margin: 0;
}

.side-nav__close {
  background: transparent;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: palette(surface-contrast, 0.7);
  padding: space(1);
}

/* List Styles */
.side-nav__section + .side-nav__section {
  margin-top: density(4);
}

.side-nav__section-title {
  @ds-typo(h5);
  margin: 0 0 density(2) 0;
}

.side-nav__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: density(1);
}

.side-nav__link {
  @ds-typo(body);
  text-decoration: none;
  padding: density(1);
  border-radius: radius(1);
  display: block;
  transition: all 0.2s ease;
}

.side-nav__link:hover {
  background: palette(primary-light);
  color: palette(primary-dark);
  opacity: 0.8;
}

.side-nav__link[aria-current="page"] {
  background: palette(primary-light);
  color: palette(primary-dark);
  font-weight: 600;
}