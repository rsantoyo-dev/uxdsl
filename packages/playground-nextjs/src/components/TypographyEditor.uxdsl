/* The Typography editor of the Live theme handler (/docs/theme). Every value is a UXDSL token,
   role or directive; the literals left are layout (grid, flex). */

/* One class per text role of the base theme, so every sample is @ds-typo itself. */
@each $role in default, tag, h1, h2, h3, h4, h5, h6, p, body, span, small, code, pre, caption, body-sm, subtitle2 {
  .tye-typo--#{$role} {
    @ds-typo(#{$role});
  }
}

.tye__toolbar {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.tye__roles {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
}

.tye__role {
  @ds-button(outlined 1);
  @ds-typo(code);
}

.tye__hint,
.tye__note {
  @ds-typo(caption);

  color: palette(text.secondary);
}

.tye {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) lg(minmax(0, 3fr) minmax(0, 2fr));
  gap: density(4);
}

.tye__preview,
.tye__editor {
  display: flex;
  flex-direction: column;
  gap: density(3);
  min-width: 0;
}

/* The chosen role, live at this width. */
.tye__stage {
  @ds-surface(outlined radius(3));

  display: flex;
  flex-direction: column;
  gap: density(2);
  background: palette(surface.main);
}

.tye__stage-label {
  @ds-typo(code);

  color: palette(primary.main);
}

.tye__sample {
  color: palette(text.primary);
  overflow-wrap: anywhere;
}

.tye__sample-text {
  @ds-input(underline);
  @ds-typo(caption);
}

.tye__title {
  @ds-typo(subtitle2);
}

.tye__sizes,
.tye__fonts {
  @ds-surface(outlined radius(2));

  display: flex;
  flex-direction: column;
  gap: density(1);
}

.tye__size,
.tye__font {
  display: grid;
  grid-template-columns: space(9) minmax(0, 1fr) space(11) space(14);
  align-items: center;
  gap: density(2);
  padding: density(1);
  border-radius: radius(1);

  &.is-active {
    background: palette(surface.light);
  }
}

.tye__font {
  grid-template-columns: space(9) minmax(0, 1fr);
}

.tye__bp {
  @ds-typo(code);
}

.tye__px,
.tye__tag {
  @ds-typo(caption);

  color: palette(text.secondary);
}

.tye__select {
  @ds-input(outlined);
  @ds-typo(body-sm);
}

/* The fields of the role. */
.tye__written {
  @ds-typo(code);
}

.tye__field {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.tye__field-head {
  display: flex;
  align-items: center;
  gap: density(2);
}

.tye__field-name {
  @ds-typo(code);

  color: palette(text.primary);
}

.tye__badge {
  @ds-surface(contained primary radius(pill));
  @ds-typo(caption);

  padding: density(0) density(2);

  &.is-inherited {
    @ds-surface(outlined radius(pill));

    padding: density(0) density(2);
  }
}

.tye__field-controls {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
}

.tye__text {
  @ds-input(outlined);
  @ds-typo(code);

  flex: 1;
  min-width: space(15);
}

.tye__error {
  @ds-typo(caption);

  color: palette(error.main);
}

/* Every role at once: an edit to default shows in each role that takes from it. */
.tye__scale {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.tye__scale-row {
  @ds-button(flat 2);

  display: grid;
  grid-template-columns: space(13) minmax(0, 1fr);
  align-items: baseline;
  gap: density(3);
  border: border(1);
  border-color: transparent;
  text-align: start;

  &.is-selected {
    border-color: palette(primary.main);
  }
}

.tye__scale-role {
  @ds-typo(code);

  color: palette(text.secondary);
}

/* One line per role, so a large heading does not push the scale off the screen. */
.tye__scale-sample {
  overflow: hidden;
  color: palette(text.primary);
  white-space: nowrap;
  text-overflow: ellipsis;
}
