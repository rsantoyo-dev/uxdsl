.theme-background-container {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0; /* Behind content but check parent context */
  overflow: hidden;
  pointer-events: none;
  background: palette(surface-main);
}

.theme-background-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* Opacity is controlled by inline style in component for fade-in */
  filter: saturate(1.1);
  transition: opacity 1s ease-in-out, transform 1s ease;
}

.theme-background-loading {
  position: absolute;
  top: 65%; /* Adjusted vertical position */
  left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-code, monospace);
  font-size: 0.75rem;
  color: palette(text-secondary);
  z-index: 1;
  opacity: 0.8;
  animation: pulse 1.5s ease-in-out infinite;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.theme-background-tint {
  position: absolute;
  inset: 0;
  background: palette(primary-main);
  opacity: 0.15; /* Reduced tint opacity */
  mix-blend-mode: color;
  z-index: 2;
}

.theme-background-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    palette(surface-light, 0.5) 0%, /* Reduced top opacity */
    palette(surface-main, 0.05) 50%, /* Much lower middle opacity */
    palette(surface-main, 0.5) 100% /* Reduced bottom opacity */
  );
  z-index: 3;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
