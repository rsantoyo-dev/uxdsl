.theme-background-container {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0; /* Behind content but check parent context */
  overflow: hidden;
  pointer-events: none;
  background: palette(surface-main);
}

.theme-background-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.4; /* Increased visibility */
  filter: saturate(1.1);
  transition: opacity 1s ease, transform 1s ease;
}

.theme-background-tint {
  position: absolute;
  inset: 0;
  background: palette(primary-main);
  opacity: 0.3;
  mix-blend-mode: color;
  z-index: 1;
}

.theme-background-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    palette(surface-light, 0.95) 0%,
    palette(surface-main, 0.4) 40%,
    palette(surface-main, 0.9) 100%
  );
  z-index: 2;
}
