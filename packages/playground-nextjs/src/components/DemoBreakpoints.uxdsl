/* DemoBreakpoints styles */

.breakpoints-section {
  display: flex;
  flex-direction: column;
  gap: density(4);
}

.breakpoints-header {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.breakpoints-viz-container {
  @ds-surface(contained);
  padding: density(4);
  display: flex;
  flex-direction: column;
  gap: density(4);
}

.breakpoints-bar-wrapper {
  width: 100%;
  overflow-x: auto;
  padding-bottom: density(2);
}

.breakpoints-bar {
  display: flex;
  height: 80px;
  width: 100%;
  min-width: 800px; /* Minimum width to visualize scales */
  border-radius: radius(2);
  overflow: hidden;
  box-shadow: shadow(1);
}

.breakpoints-segment {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: bold;
  transition: width 0.2s ease, background-color 0.2s ease;
  position: relative;
  padding: 0 density(1);
  overflow: hidden;
  white-space: nowrap;
}

.breakpoints-segment-label {
  opacity: 0.9;
}

.breakpoints-segment-val {
  font-size: 0.75rem;
  opacity: 0.7;
  font-family: monospace;
  margin-top: 4px;
}

/* Segment Colors - Backgrounds from palette, Text standardized for contrast */
.breakpoints-segment--xs { background: palette(neutral-light); color: palette(neutral-dark); }
.breakpoints-segment--sm { background: palette(info-light); color: palette(neutral-dark); }
.breakpoints-segment--md { background: palette(success-light); color: palette(primary-contrast); } /* White text for green */
.breakpoints-segment--lg { background: palette(warning-light); color: palette(neutral-dark); }
.breakpoints-segment--xl { background: palette(error-light); color: palette(primary-contrast); } /* White text for red */

.breakpoints-controls {
  @ds-surface(outlined);
  padding: density(3);
  display: flex;
  flex-direction: column;
  gap: density(2);
  max-width: 600px;
}

.breakpoints-control-row {
  display: flex;
  align-items: center;
  gap: density(2);
}

.breakpoints-control-label {
  width: 40px;
  font-weight: bold;
  text-transform: uppercase;
  font-size: 0.8rem;
}

.breakpoints-slider {
  flex: 1;
  cursor: pointer;
}

.breakpoints-input-val {
  width: 70px;
  padding: 4px 8px;
  border: 1px solid palette(neutral-light);
  border-radius: radius(1);
  font-family: monospace;
  text-align: right;
}
