/* "Name a theme" (AIPrompt) in the home page's hero. Every value is a UXDSL token, role or
   directive; the literals left are layout (flex) and the spinner's motion. */

.ai-prompt {
  display: flex;
  flex-direction: column;
  gap: density(2);
  width: 100%;
}

/* The field: an outlined Input shape holding an icon, the text and the submit button. */
.ai-prompt__form {
  @ds-surface(outlined radius(pill));

  display: flex;
  align-items: center;
  gap: density(2);
  padding: density(1) density(1) density(1) density(3);
  background: palette(surface.main);

  &:focus-within {
    border-color: palette(primary.main);
  }
}

.ai-prompt__icon {
  flex: none;
  color: palette(primary.main);
}

.ai-prompt__input {
  @ds-typo(body);

  flex: 1;
  min-width: 0;
  padding: density(2) density(0);
  border: border(0);
  background: transparent;
  color: palette(text.primary);
  outline: none;

  &::placeholder {
    color: palette(text.secondary);
  }

  /* The field itself shows keyboard focus (the pill around it only changes its border). */
  &:focus-visible {
    outline: space(1) solid palette(primary.main);
    outline-offset: space(1);
    border-radius: radius(1);
  }
}

.ai-prompt__submit {
  @ds-button(contained primary 2 radius(pill));

  display: inline-flex;
  align-items: center;
}

@keyframes ai-prompt-spin {
  to {
    transform: rotate(360deg);
  }
}

.ai-prompt__spinner {
  animation: ai-prompt-spin 1s linear infinite;
}

/* Suggestions to play with, and the theme in use: small and quiet. */
.ai-prompt__row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(1);
}

.ai-prompt__suggestion {
  @ds-button(outlined 1 radius(pill));
  @ds-typo(caption);
}

.ai-prompt__status {
  @ds-typo(caption);

  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(1);
  margin-left: auto;
  color: palette(text.secondary);
}

.ai-prompt__reset {
  @ds-button(flat 1);
  @ds-typo(caption);

  display: inline-flex;
  align-items: center;
  gap: density(1);
}

.ai-prompt__error {
  @ds-typo(caption);

  color: palette(error.main);
}
