/* "Name a theme" (AIPrompt) in the home page's hero: one quiet line under the brand, a small
   field, the names to try and the theme in use. Every value is a UXDSL token, role or
   directive; the literals left are layout (flex) and the spinner's motion. Quiet is not
   small to the finger: the field and each name keep a height a thumb can hit (space(7)),
   and on a phone the field's text is the body size, which a phone does not zoom into. */

.ai-prompt {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(1) density(3);
}

/* The field: a pill with a quiet edge, holding an icon, the text and the submit button. */
.ai-prompt__form {
  @ds-surface(outlined radius(pill));

  box-sizing: border-box;
  display: flex;
  flex: xs(1 1 100%) sm(0 1 space(16));
  align-items: center;
  min-height: space(7);
  gap: density(1);
  padding: density(0) density(1) density(0) density(2);
  border-color: palette(surface.dark);
  background: palette(surface.main);

  &:focus-within {
    border-color: palette(primary.main);
  }
}

.ai-prompt__icon {
  flex: none;
  color: palette(text.secondary);
}

.ai-prompt__input {
  @ds-typo(body);

  flex: 1;
  min-width: 0;
  padding: density(1) density(0);
  border: border(0);
  background: transparent;
  color: palette(text.primary);
  outline: none;

  &::placeholder {
    color: palette(text.secondary);
  }

  /* The field itself shows keyboard focus (the pill around it only changes its border). */
  &:focus-visible {
    outline: space(1) solid palette(primary.main);
    outline-offset: space(1);
    border-radius: radius(1);
  }
}

@media (--md) {
  .ai-prompt__input {
    @ds-typo(body-sm);
  }
}

.ai-prompt__submit {
  @ds-button(flat primary 1 radius(pill));

  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: space(7);
  min-height: space(7);
}

@keyframes ai-prompt-spin {
  to {
    transform: rotate(360deg);
  }
}

.ai-prompt__spinner {
  animation: ai-prompt-spin 1s linear infinite;
}

/* Names to try: text, not chips. */
.ai-prompt__row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(0);
}

.ai-prompt__suggestion {
  @ds-button(flat 1);
  @ds-typo(caption);

  min-height: space(7);
  color: palette(text.secondary);

  &:hover:not(:disabled) {
    color: palette(primary.main);
  }
}

.ai-prompt__status {
  @ds-typo(caption);

  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(1);
  color: palette(text.secondary);
}

.ai-prompt__reset {
  @ds-button(flat 1);
  @ds-typo(caption);

  display: inline-flex;
  align-items: center;
  gap: density(1);
  min-height: space(7);
}

/* A line of its own under the field. */
.ai-prompt__error {
  @ds-typo(caption);

  flex: 1 1 100%;
  color: palette(error.main);
}
