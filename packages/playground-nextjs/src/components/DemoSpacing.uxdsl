/* DemoSpacing component styles (UXDSL) */

/* Concentric spacing demo */
.spacing-demo { width: 320px; height: 320px; margin: 0 auto; position: relative; }
.spacing-demo__layer { box-sizing: border-box; width: 100%; height: 100%; position: absolute; inset: 0; border-radius: radius(2); background-clip: content-box; border: 1px solid color-mix(in srgb, var(--ds__palette__primary-dark) 35%, transparent); }
.spacing-demo__label { position: absolute; top: space(1); left: 50%; transform: translateX(-50%); @ds-typo (small); background: palette(surface-main, 0.6); color: palette(surface-contrast); border-radius: radius(1); padding: space(1) space(2); }
.spacing-demo__layer--1  { padding: space(1);  background: palette(primary-light, 0.01); }
// .spacing-demo__layer--2  { padding: space(2);  background: palette(primary-light, 0.14); }
// .spacing-demo__layer--3  { padding: space(3);  background: palette(primary-light, 0.20); }
// .spacing-demo__layer--4  { padding: space(4);  background: palette(primary-light, 0.26); }
// .spacing-demo__layer--5  { padding: space(5);  background: palette(primary-light, 0.32); }
// .spacing-demo__layer--6  { padding: space(6);  background: palette(primary-light, 0.38); }
// .spacing-demo__layer--7  { padding: space(7);  background: palette(primary-light, 0.44); }
// .spacing-demo__layer--8  { padding: space(8);  background: palette(primary-light, 0.50); }
// .spacing-demo__layer--9  { padding: space(9);  background: palette(primary-light, 0.56); }
// .spacing-demo__layer--10 { padding: space(10); background: palette(primary-light, 0.62); }
// .spacing-demo__layer--11 { padding: space(11); background: palette(primary-light, 0.68); }
// .spacing-demo__layer--12 { padding: space(12); background: palette(primary-light, 0.74); }

/* Spacing grid helpers */
.spacing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: space(2); }
.space-box { @ds-surface (outlined); border: border(1, palette(neutral-dark, 0.2)); border-radius: radius(2); }
.space-box__inner { background: palette(primary-light); opacity: 0.1; border-radius: radius(1); }
.pad--1  { padding: space(1); }
.pad--2  { padding: space(2); }
.pad--3  { padding: space(3); }
.pad--4  { padding: space(4); }
.pad--5  { padding: space(5); }
.pad--6  { padding: space(6); }
.pad--7  { padding: space(7); }
.pad--8  { padding: space(8); }
