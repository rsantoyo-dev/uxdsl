/* Compiled to DemoSpacing.module.css; CSS Modules scopes these classes. */
.spacing-section {
  display: flex;
  flex-direction: column;
  gap: density(4);
  .spacing-header { display: flex; flex-direction: column; gap: density(2); }

  .spacing-doll-container { display: flex; flex-direction: column; gap: density(2); }
  .spacing-doll-controls { display: flex; gap: density(2); align-items: center; }
  .spacing-doll-wrapper { 
    display: flex; 
    justify-content: center; 
    align-items: center;
    /* min-height removed to adapt to content */
    overflow: auto; 
    padding: density(4);
    background: palette(surface-light);
    border-radius: radius(2);
    border: 1px solid palette(neutral-light);
    position: relative;
    transition: all 0.3s ease; /* Smooth transition when resizing */
  }

  .concentric-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .concentric-content {
    position: relative;
    z-index: 100;
    background: palette(surface-main);
    padding: density(2);
    border-radius: radius(1);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 80px;
    min-height: 40px;
    box-shadow: shadow(2);
    @ds-typo(caption);
    font-weight: bold;
    color: palette(primary-dark);
    border: 1px solid palette(neutral-light);
  }

  .concentric-ring {
    position: absolute;
    border-radius: radius(2);
    border: 1px solid palette(primary-main, 0.2);
    background: palette(primary-main, 0.03); /* Very subtle fill */
    pointer-events: auto; /* Allow hovering */
    transition: all 0.2s ease;
    display: flex;
    justify-content: center;
    align-items: flex-start; /* Label at top */
    cursor: pointer;
    padding: 0;
    font: inherit;
  }

  .concentric-ring:hover,
  .concentric-ring:focus-visible,
  .concentric-ring.is-hovered {
    border-color: palette(secondary-main);
    background: palette(secondary-main, 0.1);
    /* No z-index boost: it let outer rings obscure inner rings on hover. */
    box-shadow: 0 0 0 1px palette(secondary-main);
  }

  .ring-label {
    background: palette(secondary-main);
    color: palette(secondary-contrast);
    font-size: 0.6rem;
    padding: 1px 4px;
    border-radius: 0 0 4px 4px;
    opacity: 0;
    transition: opacity 0.2s;
    margin-top: -1px; /* Attach to border */
  }

  .concentric-ring:hover .ring-label,
  .concentric-ring:focus-visible .ring-label,
  .concentric-ring.is-hovered .ring-label {
    opacity: 1;
  }

  .concentric-ring:focus-visible {
    outline: 2px solid palette(secondary-main);
    outline-offset: 2px;
  }

  /* Generate inset classes for rings */
  @for $i from 1 through 16 {
    .concentric-ring--#{$i} {
      /* Negative inset expands from the center content */
      inset: calc(space($i) * -1);
      z-index: calc(20 - #{$i}); /* Smaller rings on top of larger rings */
    }
  }

  .spacing-grid {
    display: flex;
    flex-direction: column;
    gap: density(1);
  }

  .spacing-card {
    @ds-surface(outlined);
    padding: xs(density(2)) md(density(1) density(3)); /* more compact vertical padding on desktop */
    display: grid;
    gap: density(2);
    border-radius: radius(2);
    transition: all 0.2s ease;
    align-items: center;

    /* Mobile layout: 2 rows. Desktop (md): 3 columns. */
    grid-template-columns: xs(auto 1fr) md(120px 1fr auto);
    grid-template-areas: xs("token input" "sep sep" "preview preview") md("token input preview");
  }

  .spacing-card:hover {
    border-color: palette(primary-main);
    box-shadow: shadow(1);
  }

  .spacing-card__token {
    grid-area: token;
    @ds-typo(subtitle2);
    font-family: monospace;
    font-weight: bold;
    color: palette(primary-dark);
  }

  .spacing-card__input-wrapper {
    grid-area: input;
    display: flex;
    justify-content: xs(flex-end) md(flex-start);
  }

  .spacing-card__input {
    width: 100%;
    max-width: xs(120px) md(200px);
    padding: space(1) density(1);
    background: transparent;
    border: 1px solid palette(neutral-main);
    border-radius: radius(1);
    font-family: monospace;
    font-size: 0.85rem;
    text-align: xs(right) md(left);
    color: palette(surface-contrast);
  }

  .spacing-card__input:focus {
    border-color: palette(primary-main);
    outline: none;
  }

  .spacing-card__separator {
    grid-area: sep;
    display: md(none);
    height: 1px;
    background: palette(neutral-light, 0.5);
    width: 100%;
    margin: space(1) 0;
  }

  .spacing-card__preview {
    grid-area: preview;
    display: flex;
    justify-content: xs(center) md(flex-end);
    align-items: center;
    padding: xs(density(1) 0) md(0);
    /* Ensure it takes space but allows growth */
    min-height: 40px;
    min-width: md(60px); /* Minimum width for small squares */
  }

  .spacing-box {
    background: palette(primary-main);
    border-radius: 2px;
    /* Box shadow to make it visible if white */
    box-shadow: 0 0 0 1px palette(primary-main, 0.2);
  }

  /* Generate size classes for all 16 levels */
  @for $i from 1 through 16 {
    .spacing-box--#{$i} {
      width: space($i);
      height: space($i);
    }
  }

  /* MIG-B7-17 phase B (4): were inline style={{}} in DemoSpacing.tsx. */
  .spacing-doll-controls__label {
    display: flex;
    align-items: center;
    gap: space(3);
  }

  .demo-code-block--usage {
    width: 100%;
    max-width: 600px;
    margin: space(7) auto 0;
  }

  .demo-header--tokens {
    margin-top: 3rem;
    margin-bottom: space(6);
  }
}
