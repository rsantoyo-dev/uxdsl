/* DemoSpacing styles */

.spacing-section { display: flex; flex-direction: column; gap: density(4); }
.spacing-header { display: flex; flex-direction: column; gap: density(2); }

.spacing-doll-container { display: flex; flex-direction: column; gap: density(2); }
.doll-controls { display: flex; gap: density(2); align-items: center; }
.doll-wrapper { 
  display: flex; 
  justify-content: center; 
  width: 100%; 
  overflow: auto; 
  padding: density(2);
  background: palette(surface-light);
  border-radius: radius(2);
  border: 1px solid palette(neutral-light);
}

.doll-layer {
  border: 1px solid palette(primary-main, 0.3);
  background: palette(primary-main, 0.05);
  border-radius: radius(1);
  position: relative;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.doll-layer:hover {
  background: palette(primary-main, 0.1);
  border-color: palette(primary-main, 0.8);
  box-shadow: shadow(1);
}

.doll-label-corner {
  position: absolute;
  top: 0;
  left: 2px;
  @ds-typo(tag);
  font-size: 0.6rem;
  opacity: 0.6;
  pointer-events: none;
  white-space: nowrap;
}

.doll-center {
  background: palette(surface-main);
  padding: density(2);
  border-radius: radius(1);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80px;
  min-height: 40px;
  box-shadow: shadow(1);
  @ds-typo(caption);
  font-weight: bold;
  color: palette(primary-dark);
}

/* Generate padding classes for doll layers */
@for $i from 1 through 8 {
  .doll-layer--#{$i} {
    padding: space($i);
  }
}

.spacing-grid {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.spacing-card {
  @ds-surface(outlined);
  padding: density(2);
  display: grid;
  /* Mobile: Stacked */
  grid-template-columns: 1fr;
  gap: density(2);
  border-radius: radius(1);
  align-items: center;
  transition: transform 0.2s ease;
}

/* Desktop */
@media (min-width: 768px) {
  .spacing-card {
    grid-template-columns: 120px 1fr auto; /* Token | Input | Preview */
  }
}

.spacing-card__token {
  @ds-typo(body);
  font-weight: bold;
  font-family: monospace;
  color: palette(secondary-main);
  background: palette(secondary-main, 0.1);
  padding: 2px 6px;
  border-radius: 4px;
  width: fit-content;
}

.spacing-card__definition {
  display: flex;
  align-items: center;
}

.spacing-card__input {
  width: 100%;
  padding: 4px 8px;
  border: 1px solid palette(neutral-light);
  border-radius: radius(1);
  font-family: monospace;
  font-size: 0.9rem;
}

.spacing-card__preview {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  /* Allow height to grow */
  min-height: 40px;
  width: 100%;
}

@media (min-width: 768px) {
  .spacing-card__preview {
    justify-content: flex-end;
    width: auto;
  }
}

.spacing-box {
  background: palette(primary-main);
  opacity: 0.5;
}

@for $i from 1 through 8 {
  .spacing-box--#{$i} {
    width: space($i);
    height: space($i);
  }
}

/* Visualizing the space as a square */
.spacing-box {
  background: palette(secondary-main);
  border-radius: 2px;
  position: relative;
}

/* Generate size classes for grid boxes */
@for $i from 1 through 8 {
  .spacing-box--#{$i} {
    width: space($i);
    height: space($i);
  }
}

.spacing-card__label {
  @ds-typo(caption);
  font-family: monospace;
  font-weight: bold;
}

.spacing-card__value {
  @ds-typo(tag);
  opacity: 0.7;
}

.spacing-card__input {
  @ds-input(contained small);
  width: 100%;
  text-align: center;
  font-family: monospace;
  font-size: 0.8rem;
  position: relative;
  z-index: 10;
  cursor: text;
}
