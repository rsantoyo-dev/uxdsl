.live-preview-box {
  background: palette(surface-dark, 0.05);
  border-radius: radius(1);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: flex-start;

  /* Subtle top/bottom dashed lines to define line-height visually */
  border-top: 1px dashed palette(neutral-light, 0.5);
  border-bottom: 1px dashed palette(neutral-light, 0.5);
  
  /* Architectonic Corner Marks */
  &::before, &::after, .top-right-corner::before, .bottom-left-corner::after {
    content: '';
    position: absolute;
    width: 10px; /* Small corner piece */
    height: 10px;
    border-color: palette(neutral-main, 0.3);
    border-style: solid;
    z-index: 1; /* Above text */
  }

  &::before { /* Top-left corner */
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }
  &::after { /* Bottom-right corner */
    bottom: 0;
    right: 0;
    border-width: 0 1px 1px 0;
  }

  /* Optional additional corners for more explicit bounding box */
  .top-right-corner::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 10px; height: 10px;
    border-color: palette(neutral-main, 0.3);
    border-style: solid;
    border-width: 1px 1px 0 0;
    z-index: 1;
  }
  .bottom-left-corner::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 10px; height: 10px;
    border-color: palette(neutral-main, 0.3);
    border-style: solid;
    border-width: 0 0 1px 1px;
    z-index: 1;
  }
}

.demo-layout-grid {
  display: flex;
  flex-direction: column;
  gap: density(4);
}

.demo-logic-column {
  display: grid;
  grid-template-columns: xs(1fr) lg(2fr 1fr);
  gap: xs(density(4)) lg(density(6));
  align-items: start;
}

.live-preview-section {
  /* Full width block */
}

.typography-showcase {
  margin-top: density(6);
  padding: density(4);
  background: palette(surface-main);
  border-radius: radius(2);
  border: 1px solid palette(divider);
}

.showcase-title {
  font-size: 0.9rem;
  font-weight: 600;
  color: palette(text-secondary);
  text-transform: uppercase;
  margin-bottom: density(4);
  letter-spacing: 0.05em;
}

.showcase-grid {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.showcase-item {
  display: grid;
  grid-template-columns: 4rem 1fr;
  align-items: center;
  gap: density(4);
  padding: density(2) 0;
  border-bottom: 1px dashed palette(divider);

  &:last-child {
    border-bottom: none;
  }
}

.showcase-tag {
  font-family: font(code);
  font-size: 0.75rem;
  color: palette(text-secondary);
  text-align: right;
  padding-right: density(2);
  border-right: 2px solid palette(primary-main);
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.showcase-text {
  color: palette(text-primary);
  margin: 0 !important;
  padding: 0 !important;
  border: 1px solid palette(neutral-main, 0.2);
  background: palette(surface-main);
  width: 100%;
  text-align: left;
}

.live-preview-section {
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid palette(neutral-light);
  display: flex;
  justify-content: flex-start;
  background: palette(surface-dark);
  border-radius: 8px;
  padding: 2rem 1rem;
  overflow: hidden;
}

.live-preview-box {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  margin: 0 auto;
  background: transparent;
  border-left: 1px solid palette(divider);
  border-right: 1px solid palette(divider);
  min-height: 120px;
  padding: 0;
}

.architectural-guide-center {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  background: palette(divider);
  opacity: 0.1;
  pointer-events: none;
}

.text-container-wrapper {
  position: relative;
  width: 100%;
  max-width: 100%;
  display: flex;
  justify-content: flex-start;
}

.line-height-indicator {
  position: absolute;
  left: -8px;
  top: 0;
  bottom: 0;
  width: 4px;
  border-left: 1px solid palette(primary-main);
  border-top: 1px solid palette(primary-main);
  border-bottom: 1px solid palette(primary-main);
  opacity: 0.3;
  pointer-events: none;
}

.content-bounds-indicator {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 1px dashed palette(primary-light);
  opacity: 0.15;
  pointer-events: none;
}

.controls-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 1rem;
  width: 100%;
}

.controls-row-bottom {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: wrap;
  width: 100%;
  gap: 1rem;
}

.controls-group {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  background: palette(surface-main);
  padding: 2px;
  border-radius: 6px;
  border: 1px solid palette(neutral-main);
  flex: 1 1 auto;
  min-width: 0;
}

.control-button {
  padding: 4px 12px;
  background: transparent;
  color: palette(text-secondary);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.8rem;
  display: flex;
  align-items: center;
  justify-content: center;

  &.active {
    background: palette(primary-light);
    color: palette(primary-contrast);
  }
  
  &.is-default {
    padding: 4px 8px;
  }
}

.element-select-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: 1 1 180px;
  min-width: 0;
  
  label {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  
  select {
    @ds-input(outlined 2);
    width: auto;
    cursor: pointer;
    min-width: 120px;
    max-width: 100%;
  }
}

.ai-prompt-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  min-width: 0;
  flex-wrap: nowrap;
  
  .input-wrapper {
    position: relative;
    flex: 0 1 66%;
    min-width: 0;
    display: flex;
    align-items: center;
    
    .ai-icon-btn {
      position: absolute;
      left: 4px;
      background: transparent;
      border: none;
      cursor: pointer;
      color: palette(neutral-main);
      opacity: 0.5;
      padding: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;

      &:hover {
        opacity: 1;
        color: palette(primary-main);
      }
    }
    
    input {
      min-width: 0;
      @ds-input(outlined 2);
      height: 32px;
      padding-left: 30px;
    }
  }
  
  .actions {
    display: flex;
    gap: 0.25rem;
    flex-shrink: 0;
    flex: 0 0 33%;
    justify-content: flex-end;
    
    button.fix-single {
       background: palette(primary-main);
       color: palette(primary-contrast);
       border: none;
       border-radius: 6px;
       padding: 6px 10px;
       cursor: pointer;
       font-size: 0.75rem;
       font-weight: 600;
       white-space: nowrap;
    }
    
    button.fix-all {
       background: transparent;
       color: palette(primary-main);
       border: 1px solid palette(primary-main);
       border-radius: 6px;
       padding: 6px 10px;
       cursor: pointer;
       font-size: 0.75rem;
       font-weight: 600;
       white-space: nowrap;
    }
  }
  
  .loading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: palette(primary-main);
    font-size: 0.8rem;
  }
}

.json-preview-container {
  background: palette(surface-main);
  padding: 1rem;
  border-radius: 6px;
  margin-bottom: 1.5rem;
  border: 1px dashed palette(neutral-main);
  color: palette(primary-dark);
  text-align: left;
  overflow-x: auto;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.json-preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.5rem;

  span {
    font-size: 0.8rem;
    color: palette(text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
}

.css-usage-container {
  margin-bottom: 1.5rem;
  padding: 1rem;
  background: palette(surface-light);
  border: 1px solid palette(neutral-light);
  border-radius: 6px;
}

.css-usage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.5rem;
  
  span {
    font-size: 0.8rem;
    color: palette(text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
}

.css-code-block {
  background: palette(surface-dark);
  padding: 0.75rem;
  border-radius: 6px;
  color: palette(text-primary);
  display: flex;
  align-items: center;
  overflow-x: auto;
  border: 1px solid palette(neutral-dark);

  .selector {
    color: palette(secondary-light);
  }

  .bracket {
    margin-left: 0.5rem;
    color: palette(text-disabled);
  }

  .mixin {
    margin-left: 0.5rem;
    color: palette(primary-light);
  }

  .paren {
    color: palette(text-primary);
  }

  .argument {
    color: palette(warning-light);
  }

  .semicolon {
    color: palette(text-disabled);
  }
}

.css-usage-description {
  margin-top: 0.75rem;
  font-size: 0.8rem;
  color: palette(text-secondary);
  line-height: 1.5;
  
  strong {
    color: palette(text-primary);
  }
}

.editable-typography-element {
  margin: 0;
  transition: all 0.2s ease;
  outline: none;
  min-width: 10px;
  cursor: text;
  text-align: left;
  width: 100%;
  position: relative;
  z-index: 2;

  $tags: default, h1, h2, h3, h4, h5, h6, p, body, caption, span, small, pre;

  @each $tag in $tags {
    &.#{$tag} {
      font-size: var(--#{$tag}-size);
      font-family: var(--#{$tag}-font-family);
      font-weight: var(--#{$tag}-weight);
      line-height: var(--#{$tag}-line);
      letter-spacing: var(--#{$tag}-spacing);
      text-transform: var(--#{$tag}-transform);
      text-decoration: var(--#{$tag}-decoration);
      font-style: var(--#{$tag}-style);
      margin-block-start: var(--#{$tag}-margin-block-start);
      margin-block-end: var(--#{$tag}-margin-block-end);
    }
  }

  &.code {
    font-size: var(--pre-size);
    font-family: var(--pre-font-family);
    font-weight: var(--pre-weight);
    line-height: var(--pre-line);
    letter-spacing: var(--pre-spacing);
    text-transform: var(--pre-transform);
    text-decoration: var(--pre-decoration);
    font-style: var(--pre-style);
    margin-block-start: var(--pre-margin-block-start);
    margin-block-end: var(--pre-margin-block-end);
  }
}

.showcase-text {
  $tags: default, h1, h2, h3, h4, h5, h6, p, body, caption, span, small, pre;

  @each $tag in $tags {
    &.sample-#{$tag} {
      font-size: var(--#{$tag}-size);
      font-family: var(--#{$tag}-font-family);
      font-weight: var(--#{$tag}-weight);
      line-height: var(--#{$tag}-line);
      letter-spacing: var(--#{$tag}-spacing);
      text-transform: var(--#{$tag}-transform);
      text-decoration: var(--#{$tag}-decoration);
      font-style: var(--#{$tag}-style);
      margin-block-start: var(--#{$tag}-margin-block-start);
      margin-block-end: var(--#{$tag}-margin-block-end);
    }
  }

  &.sample-code {
    font-size: var(--pre-size);
    font-family: var(--pre-font-family);
    font-weight: var(--pre-weight);
    line-height: var(--pre-line);
    letter-spacing: var(--pre-spacing);
    text-transform: var(--pre-transform);
    text-decoration: var(--pre-decoration);
    font-style: var(--pre-style);
    margin-block-start: var(--pre-margin-block-start);
    margin-block-end: var(--pre-margin-block-end);
  }
}

.json-property-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding-left: 2ch;
}

.json-key {
  color: palette(secondary-main);
}

.json-value-inherited {
  color: palette(text-disabled);
}

.json-comment {
  font-size: 0.75rem;
  color: palette(text-disabled);
  margin-left: 0.5rem;
}

.json-action-group {
  display: flex;
  gap: 0.25rem;
}

.json-action-button {
  background: transparent;
  border: 1px solid palette(divider);
  border-radius: 4px;
  padding: 4px;
  cursor: pointer;
  color: palette(text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;

  &:hover {
    color: palette(primary-main);
    border-color: palette(primary-main);
  }

  &.delete-button {
    border: none;
    color: palette(text-disabled);

    &:hover {
      color: palette(error-main);
      background: transparent;
    }
  }
}

.editable-typography-element {
  margin: 0;
  transition: all 0.2s ease;
  outline: none;
  min-width: 10px;
  cursor: text;
  text-align: left;
  width: 100%;
  position: relative;
  z-index: 2;
}
