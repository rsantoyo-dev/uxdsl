/* Demo layout only; input visuals and states come from the shared engine. */
.module-root {

  .section { margin-block: density(3); }
  .surfaces-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: density(3);
    margin-block: density(3);
  }
}
.inputs-section pre { overflow-x: auto; }
.inputs-section label { margin-inline-end: density(2); }
