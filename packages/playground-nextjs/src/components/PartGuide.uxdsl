/* The first thing in every open part of the Live theme handler (PartGuide.tsx). Every value
   is a UXDSL token, role or directive; the literals left are layout (flex). */

.pgd {
  display: flex;
  flex-direction: column;
  gap: density(2);
  margin-bottom: density(3);
}

.pgd__what {
  @ds-typo(body);

  margin: density(0);
  color: palette(text.primary);
}

.pgd__try {
  @ds-surface(contained primary radius(2));
  @ds-typo(body-sm);

  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: density(2);
  margin: density(0);
}

.pgd__badge {
  @ds-typo(caption);

  font-weight: 700;
  text-transform: uppercase;
}
