/* AppHeader styles - Scoped - Flattened to avoid compiler nesting bugs */

#AppHeader {
  width: 100%;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, palette(primary-dark) 0%, palette(primary-main) 100%);
  /* Fallback if gradient fails */
  background-color: palette(primary-main);
  color: palette(primary-contrast);
  position: relative;
  z-index: 1000;
  box-shadow: shadow(2);
  border-bottom: 1px solid palette(primary-light, 0.3);
}

#AppHeader .app-header__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: density(3) xs(space(2)) md(space(4)); /* Increased vertical padding to density(3) */
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

/* Logo Container - 120px Centered */
#AppHeader .app-header__inner {
  @ds-surface(contained light);
  display: flex;
  flex-direction: row; /* Changed to row */
  align-items: flex-end; /* Align text with bottom of logo */
  gap: 8px; /* Adjusted gap for row layout */
  background: palette(surface-light, 0.9); /* Corrected alpha */
  text-decoration: none;
  cursor: pointer;
  color: inherit;
  transition: transform 0.2s;

  &:hover {
    transform: translateY(-1px);
  }
}

#AppHeader .app-header__logo-img {
  display: block;
  width: xs(40px) sm(50px) md(70px); /* Changed from md(60px) to md(70px) */
  height: xs(40px) sm(50px) md(70px); /* Changed from md(60px) to md(70px) */
}

#AppHeader .app-header__title-text {
  @ds-typo (h6);
  color: palette(primary-dark);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.5px;
  white-space: nowrap;
  margin-bottom: space(1); /* Adjusted to align with logo bottom, using 8px as 'spacing 3' */
}

#AppHeader .app-header__subtitle-text {
  @ds-typo(caption);
  opacity: 0.8;
  font-weight: 500;
  font-size: 0.5rem; /* Super small */
  line-height: 1.1;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap; /* Ensure it fits or scales */
}

#AppHeader .app-header__actions {
  display: flex;
  align-items: center;
  gap: density(2);
}

#AppHeader .app-header__settings {
  display: flex;
  align-items: center;
  gap: density(2);
}

#AppHeader .theme-color-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 3px solid var(--theme-color);
  background: rgba(255, 255, 255, 0.1);
  cursor: pointer;
  transition: all 0.2s ease;
  padding: 0;
  box-sizing: border-box;
}

#AppHeader .theme-color-btn:hover {
  transform: scale(1.1);
  background: rgba(255, 255, 255, 0.2);
}

#AppHeader .theme-color-btn.is-active {
  box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.15);
}

#AppHeader .divider-vertical {
  width: 1px;
  height: 20px;
  background-color: rgba(255, 255, 255, 0.2);
  margin: 0 density(1);
}

#AppHeader .theme-toggle {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  padding: 0;
  box-sizing: border-box;
}

#AppHeader .theme-toggle:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
}
