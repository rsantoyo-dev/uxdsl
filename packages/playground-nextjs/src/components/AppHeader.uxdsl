/* AppHeader styles - Scoped - Flattened to avoid compiler nesting bugs */

#AppHeader {
  width: 100%;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, palette(primary-dark) 0%, palette(primary-main) 100%);
  /* Fallback if gradient fails */
  background-color: palette(primary-main);
  color: palette(primary-contrast);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: shadow(2);
  border-bottom: 1px solid palette(primary-light, 0.3);
}

#AppHeader .app-header__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: density(2) xs(space(2)) md(space(4));
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

/* Logo Container - 120px Centered */
#AppHeader .app-header__inner {
  @ds-surface(contained light);
  display: flex;
  flex-direction: row; /* Changed to row */
  align-items: flex-end; /* Align text with bottom of logo */
  gap: 8px; /* Adjusted gap for row layout */
  background: palette(surface-light, 0.15); /* Corrected alpha */
}

#AppHeader .app-header__logo-img {
  display: block;
  /* Default size for larger screens (md and above) */
  width: 60px;
  height: 60px;
}

/* For extra small screens (xs) */
@media (max-width: 479px) {
  #AppHeader .app-header__logo-img {
    width: 40px;
    height: 40px;
  }
}

/* For small screens (sm) */
@media (min-width: 480px) and (max-width: 767px) {
  #AppHeader .app-header__logo-img {
    width: 50px;
    height: 50px;
  }
}

#AppHeader .app-header__title-text {
  @ds-typo(h6);
  font-weight: 800;
  margin: 0;
  line-height: 1;
  letter-spacing: -0.5px;
  white-space: nowrap;
  margin-bottom: -8px; /* Adjusted to align with logo bottom, using 8px as 'spacing 3' */
}

#AppHeader .app-header__subtitle-text {
  @ds-typo(caption);
  opacity: 0.8;
  font-weight: 500;
  font-size: 0.5rem; /* Super small */
  line-height: 1.1;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap; /* Ensure it fits or scales */
}

#AppHeader .app-header__actions {
  display: flex;
  align-items: center;
  gap: density(2);
}

/* Breakpoint Monitor Badge */
#AppHeader .bp-monitor {
  display: flex;
  align-items: center;
  gap: density(1);
  background: rgba(255,255,255,0.1);
  color: palette(primary-contrast);
  padding: 4px 10px;
  border-radius: radius(1);
  font-size: 0.75rem;
  font-family: monospace;
  height: 30px;
  width: fit-content;
}

#AppHeader .bp-monitor__label {
  font-weight: bold;
  color: palette(primary-contrast);
}

#AppHeader .bp-monitor__val {
  opacity: 0.7;
  border-left: 1px solid rgba(255,255,255,0.2);
  padding-left: density(1);
}

#AppHeader .theme-toggle {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: palette(primary-contrast);
  padding: density(2);
  border-radius: radius(full);
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
}

#AppHeader .theme-toggle:hover {
  background: rgba(255,255,255,0.2);
  transform: scale(1.05);
}
