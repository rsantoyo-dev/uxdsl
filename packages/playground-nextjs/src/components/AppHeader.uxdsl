/* The site header: brand, version, the three links every page needs, and the theme controls.
   It is drawn on the surface palette, so light and dark mode both come from the theme's
   `modes.dark.palette`; nothing here knows which mode is active. */

.app-header {
  width: 100%;
  position: relative;
  z-index: 1000;
  background: palette(surface.light);
  color: palette(surface.contrast);
  border-bottom: border(1);
  box-shadow: shadow(1);
}

.app-header__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: space(3) xs(space(4)) md(space(6));
  display: flex;
  align-items: center;
  gap: xs(space(3)) md(space(6));
}

.app-header__brand {
  display: flex;
  align-items: center;
  gap: space(3);
  min-width: 0;
}

.app-header__home {
  display: flex;
  align-items: center;
  gap: space(3);
  text-decoration: none;
  color: inherit;
  border-radius: radius(1);

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 3px;
  }
}

.app-header__logo-img {
  display: block;
  width: xs(32px) md(40px);
  height: xs(32px) md(40px);
}

.app-header__title-text {
  @ds-typo(h6);
  margin: 0;
  color: palette(primary.main);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
}

.app-header__version {
  @ds-typo(caption);
  display: xs(none) sm(inline-block);
  margin: 0;
  padding: space(1) space(3);
  border: 1px solid palette(divider.main);
  border-radius: radius(pill);
  color: palette(text.secondary);
  text-decoration: none;
  white-space: nowrap;
  font-family: var(--uxdsl__font__code), monospace;

  &:hover {
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.app-header__links {
  display: flex;
  align-items: center;
  gap: xs(space(1)) md(space(3));
  margin-left: auto;
}

.app-header__link {
  @ds-typo(span);
  display: inline-flex;
  align-items: center;
  gap: space(2);
  margin: 0;
  padding: space(2) xs(space(2)) md(space(3));
  border-radius: radius(1);
  color: palette(surface.contrast);
  text-decoration: none;
  font-weight: 600;
  white-space: nowrap;

  &:hover {
    background: palette(primary.main, 0.1);
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

/* Icon-only on phones; the aria-label carries the name. */
.app-header__link-label {
  display: xs(none) md(inline);
}

.app-header__settings {
  display: flex;
  align-items: center;
  gap: space(3);
}

.app-header__themes {
  display: xs(none) sm(flex);
  align-items: center;
  gap: space(2);
}

.theme-color-btn {
  width: 28px;
  height: 28px;
  border-radius: radius(circle);
  border: 3px solid var(--theme-color);
  background: palette(surface.main);
  cursor: pointer;
  padding: 0;
  transition: transform 0.15s ease;

  &:hover {
    transform: scale(1.1);
  }

  &.is-active {
    box-shadow: 0 0 0 2px palette(surface.light), 0 0 0 4px palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 4px;
  }
}

/* Swatches of *other* themes, which the active Palette cannot give: Color identities. */
.theme-color-btn--default {
  --theme-color: color(purple.600);
}

.theme-color-btn--green {
  --theme-color: color(green.600);
}

.theme-color-btn--slate {
  --theme-color: color(slate.800);
}

.theme-color-btn--custom {
  --theme-color: color(pink.300);
}

.theme-toggle {
  width: 32px;
  height: 32px;
  border-radius: radius(circle);
  background: palette(surface.main);
  border: border(1);
  color: palette(surface.contrast);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;

  &:hover {
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}
