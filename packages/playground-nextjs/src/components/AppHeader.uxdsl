.app-header {
  background: palette(primary-main);
  padding: 0;
  color: palette(primary-contrast);
  position: relative;
  box-shadow: shadow(1);
}

.app-header__container {
  max-width: 1400px;
  margin: 0 auto;
  padding: density(2) xs(space(2)) md(space(4));
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

/* Logo Container - 100px Centered */
.app-header__inner {
  @ds-surface(contained);
  background-color: color(gray-800);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 100px;
  gap: 2px;
}

.app-header__logo-img {
  display: block;
  /* Dimensions handled by HTML attr */
}

.app-header__title-text {
  @ds-typo (h6);
  font-weight: 800;
  margin: 0;
  line-height: 1;
  letter-spacing: -0.5px;
  color: color(gray-50);
}

.app-header__subtitle-text {
  @ds-typo(caption);
  opacity: 0.8;
  font-weight: 500;
  font-size: 0.5rem; /* Super small */
  line-height: 1.1;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap; /* Ensure it fits or scales */
}

.app-header__actions {
  display: flex;
  align-items: center;
  gap: density(2);
}

/* Breakpoint Monitor Badge */
.bp-monitor {
  display: flex;
  align-items: center;
  gap: density(1);
  background: rgba(255,255,255,0.1);
  color: palette(primary-contrast);
  padding: 4px 10px;
  border-radius: radius(1);
  font-size: 0.75rem;
  font-family: monospace;
  height: 30px;
  width: fit-content;
}

.bp-monitor__label {
  font-weight: bold;
  color: palette(primary-contrast);
}

.bp-monitor__val {
  opacity: 0.7;
  border-left: 1px solid rgba(255,255,255,0.2);
  padding-left: density(1);
}

.theme-toggle {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: palette(primary-contrast);
  padding: density(2);
  border-radius: radius(full);
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
}

.theme-toggle:hover {
  background: rgba(255,255,255,0.2);
  transform: scale(1.05);
}