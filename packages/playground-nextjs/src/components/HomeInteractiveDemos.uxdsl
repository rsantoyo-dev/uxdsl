.demos-grid {
  display: grid;
  grid-template-columns: xs(1fr) lg(repeat(2, 1fr));
  gap: density(4);
  width: 100%;
}

.demo-item {
  min-width: 0;
}

.demo-item-full {
  grid-column: lg(span 2);
}

.home-demos {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: density(3);
}

.home-demos__actions {
  width: 100%;
  display: flex;
  justify-content: center;
}

.home-demos__toggle {
  @ds-button(flat secondary 1);
  min-width: 6rem; /* Local control width, outside the Density spacing scale. */
  opacity: 0.85;

  &:hover {
    opacity: 1;
  }
}

/* MIG-B7-17 phase B (4): was inline style={{}} on DocsLink in HomeInteractiveDemos.tsx. */
a.docs-link {
  display: flex;
  align-items: center;
  gap: space(2);
  font-size: 0.75rem;
  color: palette(primary.main);
  text-decoration: none;
  font-weight: 600;
}
