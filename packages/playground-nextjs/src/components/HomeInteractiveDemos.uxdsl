.demos-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: density(4);
  width: 100%;

  @media (min-width: 1024px) {
    grid-template-columns: repeat(2, 1fr);
  }
}

.demo-item {
  min-width: 0;
}

.demo-item-full {
  @media (min-width: 1024px) {
    grid-column: span 2;
  }
}

.home-demos {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: density(3);
}

.home-demos__actions {
  width: 100%;
  display: flex;
  justify-content: center;
}

.home-demos__toggle {
  @ds-button (flat secondary small);
  min-width: density(24);
  opacity: 0.85;

  &:hover {
    opacity: 1;
  }
}
