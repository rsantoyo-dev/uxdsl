/* The "AI implementation guide" section that closes each documentation page.
   Was AgentGuidance.module.css (MIG-B7-17 phase B): classes are prefixed because .uxdsl is
   global. Stable spacing uses space(); the code panel and edge use Color identities, dark
   in both modes on purpose. Font sizes are this section's own prose scale, not a role. */

.agent-guidance {
  margin-block: 3rem;
  padding: clamp(space(5), 3vw, space(7));
  border: 1px solid color(gray-400);
  border-radius: 0.75rem;
  min-width: 0;
  line-height: 1.7;
  scroll-margin-top: 5rem;
}

.agent-guidance__label {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.agent-guidance h2 {
  font-size: 1.5rem;
  margin-block: space(3) space(5);
}

.agent-guidance h3 {
  font-size: 1.15rem;
  margin-block: space(6) space(4);
}

.agent-guidance p {
  margin-block: space(4);
}

.agent-guidance ul, .agent-guidance ol {
  padding-inline-start: space(6);
  margin-block: space(5);
}

.agent-guidance ul {
  list-style: disc;
}

.agent-guidance ol {
  list-style: decimal;
}

.agent-guidance li {
  margin-block: space(3);
}

.agent-guidance pre {
  overflow-x: auto;
  padding: space(5);
  background: color(gray-900);
  color: color(gray-200);
  border-radius: 0.5rem;
  font-size: 0.85rem;
}

.agent-guidance blockquote {
  border-inline-start: 3px solid color(gray-400);
  padding-inline-start: space(5);
  margin-block: space(5);
}
