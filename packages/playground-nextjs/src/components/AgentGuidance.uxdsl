/* One primitive's guide on /docs/for-ai-agents, as a disclosure. The code panel is a Color
   identity, dark in both modes on purpose. */

.agent-guidance {
  margin-block: space(4);
  border: border(1);
  border-radius: radius(2);
  background: palette(surface.main);
  min-width: 0;
  line-height: 1.7;
  scroll-margin-top: space(11);

  &[open] {
    box-shadow: shadow(1);
  }
}

.agent-guidance__summary {
  cursor: pointer;
  padding: density(3) density(4);
  border-radius: radius(2);
  list-style-position: inside;

  &:hover {
    background: palette(primary.main, 0.06);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.agent-guidance__title {
  @ds-typo(h5);
  margin: 0;
}

.agent-guidance__body {
  padding: 0 density(4) density(4);
  border-top: border(1);
}

.agent-guidance h3 {
  @ds-typo(h6);
  margin-block: space(6) space(3);
}

.agent-guidance p {
  margin-block: space(4);
}

.agent-guidance ul, .agent-guidance ol {
  padding-inline-start: space(6);
  margin-block: space(4);
}

.agent-guidance ul {
  list-style: disc;
}

.agent-guidance ol {
  list-style: decimal;
}

.agent-guidance li {
  margin-block: space(2);
}

.agent-guidance pre {
  overflow-x: auto;
  padding: space(5);
  background: color(gray.900);
  color: color(gray.200);
  border-radius: radius(2);
  font-size: 0.85rem;
}

.agent-guidance blockquote {
  border-inline-start: 3px solid palette(divider.main);
  padding-inline-start: space(5);
  margin-block: space(4);
}
