/* DemoDensity styles */

.density-section { display: flex; flex-direction: column; gap: density(4); }
.density-header { display: flex; flex-direction: column; gap: density(2); }

.density-code-snippet {
  background: palette(surface-dark);
  color: palette(surface-contrast);
  padding: density(2);
  border-radius: radius(1);
  font-family: monospace;
  font-size: 0.9rem;
  border-left: 4px solid palette(primary-main);
  margin-top: density(1);
}

.density-doll-container { display: flex; flex-direction: column; gap: density(2); }
.density-doll-controls { 
  display: flex; 
  gap: density(2); 
  align-items: center;
  position: relative;
  z-index: 10; /* Ensure controls stay above expanding rings */
}

.density-slider {
  -webkit-appearance: none;
  width: 200px;
  height: 6px;
  background: palette(neutral-light);
  border-radius: 3px;
  outline: none;
}

.density-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: palette(primary-main);
  cursor: pointer;
  transition: background .15s ease-in-out;
}

.density-slider::-webkit-slider-thumb:hover {
  background: palette(primary-light);
}

.density-slider::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border: 0;
  border-radius: 50%;
  background: palette(primary-main);
  cursor: pointer;
  transition: background .15s ease-in-out;
}

.density-slider::-moz-range-thumb:hover {
  background: palette(primary-light);
}

.density-doll-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: auto;
  overflow-x: auto; /* Enable horizontal scroll */
  overflow-y: hidden;
  padding: density(4);
  background: palette(surface-light);
  border-radius: radius(2);
  border: 1px solid palette(neutral-light);
  position: relative;
  z-index: 0;
}

/* Reuse concentric styles from spacing demo but scoped if needed, 
   or just duplicate for isolation */
.concentric-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.concentric-content {
  position: relative;
  z-index: 100;
  background: palette(surface-main);
  padding: density(2);
  border-radius: radius(1);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80px;
  min-height: 40px;
  box-shadow: shadow(2);
  @ds-typo(caption);
  font-weight: bold;
  color: palette(primary-dark);
  border: 1px solid palette(neutral-light);
}

.concentric-ring {
  position: absolute;
  border-radius: radius(2);
  border: 1px solid palette(primary-main, 0.2);
  background: palette(primary-main, 0.03);
  pointer-events: auto;
  transition: all 0.2s ease;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  cursor: pointer;
}

.concentric-ring:hover,
.concentric-ring.is-hovered {
  border-color: palette(secondary-main);
  background: palette(secondary-main, 0.1);
  box-shadow: 0 0 0 1px palette(secondary-main);
}

.ring-label {
  background: palette(secondary-main);
  color: palette(secondary-contrast);
  font-size: 0.6rem;
  padding: 1px 4px;
  border-radius: 0 0 4px 4px;
  opacity: 0;
  transition: opacity 0.2s;
  margin-top: -1px;
}

.concentric-ring:hover .ring-label,
.concentric-ring.is-hovered .ring-label {
  opacity: 1;
}

/* Generate inset classes for density rings */
@for $i from 1 through 16 {
  .concentric-ring--density-#{$i} {
    /* Negative inset expands from the center content based on density value */
    inset: calc(var(--density-#{$i}) * -1);
    z-index: calc(20 - #{$i});
  }
}

.density-grid-container {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.density-grid {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.density-card {
  @ds-surface(outlined);
  padding: density(2);
  display: flex;
  flex-direction: column;
  gap: density(2);
  border-radius: radius(1);
  height: auto;
  overflow-x: auto; /* Allow horizontal scroll if header content is too wide */
}

/* Desktop layout removed to keep stacked view */
/* 
@media (min-width: 768px) {
  .density-card {
    grid-template-columns: 1.5fr 1fr 1.5fr;
    align-items: stretch;
  }
} 
*/

.density-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: density(2);
  border-bottom: 1px solid palette(neutral-light, 0.5);
}

.density-card__header-col {
  display: flex;
  flex-direction: column;
  gap: density(0.5);
}

.density-card__header-col--main {
  /* Token & Active Rule */
  justify-content: center;
}

.density-card__header-col--bps {
  /* Breakpoints list */
  justify-content: center;
}

.density-card__header-col--right {
  /* Values & Edit button */
  flex-direction: row;
  align-items: center;
  gap: density(2);
  justify-content: flex-end;
}

.density-metric-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}

.density-card__viz {
  padding-top: density(2);
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 120px;
}

.density-card__token {
  @ds-typo(body);
  font-weight: bold;
  font-family: monospace;
  color: palette(primary-main);
  background: palette(primary-main, 0.1);
  padding: 2px 6px;
  border-radius: 4px;
  width: fit-content;
}

.density-def-list {
  display: flex;
  flex-direction: column;
  gap: 2px; /* Smaller gap */
}

.density-def-item {
  display: flex;
  gap: 4px;
  font-family: monospace;
  font-size: 0.75rem;
  background: palette(neutral-light, 0.3);
  padding: 2px 4px;
  border-radius: 2px;
  transition: all 0.2s ease;
}

.density-def-item--active {
  background: palette(primary-main, 0.15);
  color: palette(primary-dark);
  font-weight: bold;
  box-shadow: 0 0 0 1px palette(primary-main, 0.3);
}

.density-def-bp {
  font-weight: bold;
  opacity: 0.7;
}

.density-def-val {
  opacity: 0.9;
}

.density-card__edit-btn {
  padding: 4px 12px;
  font-size: 0.8rem;
  cursor: pointer;
  background: palette(surface-light);
  border: 1px solid palette(neutral-light);
  border-radius: radius(1);
  white-space: nowrap;
  transition: all 0.2s ease;
}

.density-card__edit-btn:hover {
  border-color: palette(primary-main);
  color: palette(primary-main);
}

.density-metric-item {
  display: flex;
  align-items: baseline;
  gap: 4px;
  font-family: monospace;
  font-size: 0.9rem;
}

.density-metric-label {
  font-size: 0.75rem;
  opacity: 0.6;
}

.density-metric-value {
  font-weight: 500;
}

.density-metric-value--highlight {
  color: palette(secondary-dark);
  font-weight: bold;
}

.density-concentric-viz {
  position: relative;
  width: 100%;
  height: auto; /* Allow height to grow */
  min-height: 100px;
  display: grid; /* Use Grid for stacking */
  place-items: center;
}

.density-concentric-center {
  width: 4px;
  height: 4px;
  background: palette(primary-dark);
  border-radius: 50%;
  position: relative; /* Changed from absolute */
  grid-area: 1 / 1; /* Stack in center */
  z-index: 10;
}

.density-concentric-box {
  position: relative; /* Changed from absolute */
  grid-area: 1 / 1; /* Stack in center */
  /* Removed top/left/transform centering as Grid handles it */
  border: 1px dashed;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.density-concentric-inner {
  width: 4px;
  height: 4px;
  opacity: 0;
}

.density-concentric-label {
  position: absolute;
  top: 2px;
  left: 2px;
  font-size: 0.6rem;
  font-family: monospace;
  opacity: 0.8;
  line-height: 1;
}

/* Color variations for concentric boxes */
.density-concentric-box--0 {
  border-color: palette(secondary-main);
  background: palette(secondary-main, 0.05);
  color: palette(secondary-dark);
  z-index: 3;
}

.density-concentric-box--1 {
  border-color: palette(tertiary-main);
  background: palette(tertiary-main, 0.05);
  color: palette(tertiary-dark);
  z-index: 2;
}

.density-concentric-box--2 {
  border-color: palette(primary-main);
  background: palette(primary-main, 0.05);
  color: palette(primary-dark);
  z-index: 1;
}

.density-concentric-box--active {
  border-style: solid;
  border-width: 2px;
  border-color: palette(secondary-dark);
  background: palette(secondary-main, 0.15);
  z-index: 10; /* Ensure it's on top if possible, or at least prominent */
  box-shadow: 0 0 0 1px palette(surface-main); /* Small outline to separate */
}


