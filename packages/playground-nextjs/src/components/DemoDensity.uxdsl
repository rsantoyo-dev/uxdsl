/* DemoDensity styles */

.density-section { display: flex; flex-direction: column; gap: density(4); }
.density-header { display: flex; flex-direction: column; gap: density(2); }

.density-code-snippet {
  background: palette(surface-dark);
  color: palette(surface-contrast);
  padding: density(2);
  border-radius: radius(1);
  font-family: monospace;
  font-size: 0.9rem;
  border-left: 4px solid palette(primary-main);
  margin-top: density(1);
}

.density-doll-container { display: flex; flex-direction: column; gap: density(2); }
.doll-controls { display: flex; gap: density(2); align-items: center; }

.doll-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
  overflow: auto;
  padding: density(2);
  background: palette(surface-light);
  border-radius: radius(2);
  border: 1px solid palette(neutral-light);
}

.density-doll-layer {
  border: 1px solid palette(secondary-main, 0.3);
  background: palette(secondary-main, 0.05);
  border-radius: radius(1);
  position: relative;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.density-doll-layer:hover {
  background: palette(secondary-main, 0.1);
  border-color: palette(secondary-main, 0.8);
  box-shadow: shadow(1);
}

.doll-label-corner {
  position: absolute;
  top: 0;
  left: 2px;
  @ds-typo(tag);
  font-size: 0.6rem;
  opacity: 0.6;
  pointer-events: none;
  white-space: nowrap;
}

.doll-center {
  background: palette(surface-main);
  padding: density(2);
  border-radius: radius(1);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80px;
  min-height: 40px;
  box-shadow: shadow(1);
  @ds-typo(caption);
  font-weight: bold;
  color: palette(secondary-dark);
}

@for $i from 1 through 8 {
  .density-doll-layer--#{$i} {
    padding: density($i);
  }
}

.density-grid-container {
  display: flex;
  flex-direction: column;
  gap: density(2);
}

.density-grid {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

.density-card {
  @ds-surface(outlined);
  padding: density(2);
  display: grid;
  /* Mobile layout: Stacked */
  grid-template-columns: 1fr;
  gap: density(2);
  border-radius: radius(1);
  align-items: start;
}

/* Desktop layout */
@media (min-width: 768px) {
  .density-card {
    /* 3 Columns: Defs | Metrics | Viz */
    grid-template-columns: 1.5fr 1fr 1.5fr;
    align-items: stretch; /* Stretch to match height */
  }
}

/* Column 1: Definitions */
.density-card__col-def {
  display: flex;
  flex-direction: column;
  gap: density(1);
}

@media (max-width: 767px) {
  .density-card__col-def {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .density-def-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .density-card__edit-btn {
    margin-top: 0;
  }
}

.density-card__token {
  @ds-typo(body);
  font-weight: bold;
  font-family: monospace;
  color: palette(primary-main);
  background: palette(primary-main, 0.1);
  padding: 2px 6px;
  border-radius: 4px;
  width: fit-content;
}

.density-def-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.density-def-item {
  display: flex;
  gap: 0.5rem;
  font-family: monospace;
  font-size: 0.8rem;
}

.density-def-bp {
  font-weight: bold;
  opacity: 0.7;
  width: 24px;
}

.density-def-val {
  opacity: 0.9;
}

.density-card__edit-btn {
  padding: 2px 8px;
  font-size: 0.75rem;
  cursor: pointer;
  background: palette(surface-light);
  border: 1px solid palette(neutral-light);
  border-radius: radius(1);
  white-space: nowrap;
  width: fit-content;
  margin-top: 4px;
}

/* Column 2: Metrics */
.density-card__col-metrics {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 0 density(2);
  border-left: 1px solid palette(neutral-light, 0.5);
  border-right: 1px solid palette(neutral-light, 0.5);
  justify-content: center;
}

@media (max-width: 767px) {
  .density-card__col-metrics {
    border: none;
    padding: density(2) 0;
    border-top: 1px solid palette(neutral-light, 0.3);
    border-bottom: 1px solid palette(neutral-light, 0.3);
    flex-direction: row;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  
  .density-card__col-viz {
    width: 100%;
    padding: density(2) 0;
    box-sizing: border-box;
  }
}

.density-metric-item {
  display: flex;
  flex-direction: column;
}

.density-metric-label {
  font-size: 0.65rem;
  text-transform: uppercase;
  opacity: 0.6;
  font-weight: bold;
}

.density-metric-value {
  font-family: monospace;
  font-size: 0.9rem;
}

.density-metric-value--highlight {
  color: palette(secondary-dark);
  font-weight: bold;
}

/* Column 3: Visualization */
.density-card__col-viz {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120px; /* Ensure minimum height */
  padding: density(1);
}

.density-concentric-viz {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.density-concentric-center {
  width: 4px;
  height: 4px;
  background: palette(primary-dark);
  border-radius: 50%;
  position: absolute;
  z-index: 10;
}

.density-concentric-box {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 1px dashed;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.density-concentric-inner {
  width: 4px;
  height: 4px;
  opacity: 0;
}

.density-concentric-label {
  position: absolute;
  top: 2px;
  left: 2px;
  font-size: 0.6rem;
  font-family: monospace;
  opacity: 0.8;
  line-height: 1;
}

/* Color variations for concentric boxes */
.density-concentric-box--0 {
  border-color: palette(secondary-main);
  background: palette(secondary-main, 0.05);
  color: palette(secondary-dark);
  z-index: 3;
}

.density-concentric-box--1 {
  border-color: palette(tertiary-main);
  background: palette(tertiary-main, 0.05);
  color: palette(tertiary-dark);
  z-index: 2;
}

.density-concentric-box--2 {
  border-color: palette(primary-main);
  background: palette(primary-main, 0.05);
  color: palette(primary-dark);
  z-index: 1;
}

.density-concentric-box--active {
  border-style: solid;
  border-width: 2px;
  border-color: palette(secondary-dark);
  background: palette(secondary-main, 0.15);
  z-index: 10; /* Ensure it's on top if possible, or at least prominent */
  box-shadow: 0 0 0 1px palette(surface-main); /* Small outline to separate */
}


