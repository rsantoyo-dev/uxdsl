/* Tabs: a row of buttons over one visible panel. Every value is a UXDSL token or role; the
   literals left are layout. */

.tabs {
  margin-block: density(4);
  min-width: 0;
}

.tabs__list {
  display: flex;
  flex-wrap: wrap;
  gap: density(1);
  border-bottom: border(1);
}

.tabs__tab {
  @ds-typo(span);

  margin: density(0);
  /* A tab that is an address (#surfaces) stops below the fixed header. */
  scroll-margin-top: space(11);
  padding-block: density(2);
  padding-inline: density(3);
  border: border(0);
  border-bottom: border(2);
  border-bottom-color: transparent;
  background: transparent;
  color: palette(text.secondary);
  font-weight: 600;
  cursor: pointer;

  &:hover {
    color: palette(primary.main);
  }

  &[aria-selected="true"] {
    color: palette(primary.main);
    border-bottom-color: palette(primary.main);
  }

  &:focus-visible {
    outline: space(1) solid palette(primary.main);
    outline-offset: calc(space(1) * -1);
  }
}

.tabs__panel {
  padding-top: density(3);
  min-width: 0;
}
