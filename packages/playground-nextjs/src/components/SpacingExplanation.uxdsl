/* Spacing explanation. Compiled as a CSS Module from UXDSL.
   Stable spacing uses space(); the code panel uses Color
   identities, dark in both modes on purpose. The __boxes/__padding/__gap/__content/__edit rules
   are the live "Try it" boxes that DemoSpacing.tsx renders with this same stylesheet. */

.spacing-explanation {
  margin-block: space(7);
  line-height: 1.7;
  min-width: 0;
}

.spacing-explanation h2 {
  font-size: 1.5rem;
  margin-block: space(5);
}

.spacing-explanation h3 {
  font-size: 1.2rem;
  margin-block: space(6) space(4);
}

.spacing-explanation h4 {
  margin-bottom: space(4);
}

.spacing-explanation p {
  margin-block: space(4);
}

.spacing-explanation a {
  text-decoration: underline;
}

.spacing-explanation pre {
  overflow-x: auto;
  background: color(gray-900);
  color: color(gray-200);
  padding: space(5);
  border-radius: 0.5rem;
  font-size: 0.85rem;
}

.spacing-explanation__comparison {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  gap: space(5);
}

.spacing-explanation__comparison > div {
  min-width: 0;
}

.spacing-explanation__boxes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  gap: space(5);
  margin-block: space(5);
}

.spacing-explanation__boxes figure {
  margin: 0;
  min-width: 0;
}

.spacing-explanation__boxes figcaption {
  margin-bottom: space(4);
}

.spacing-explanation__padding, .spacing-explanation__gap {
  background: color(blue-100);
  border: 1px solid color(blue-500);
  border-radius: 0.5rem;
}

.spacing-explanation__padding {
  padding: space(4);
}

.spacing-explanation__gap {
  display: flex;
  flex-wrap: wrap;
  gap: space(4);
  padding: space(2);
}

.spacing-explanation__content {
  background: color(white);
  color: color(slate-900);
  padding: space(3);
  border: 1px dashed color(gray-500);
  text-align: center;
}

.spacing-explanation__edit {
  padding: 0.65rem space(5);
  background: color(blue-500);
  color: color(white);
  border: 0;
  border-radius: 0.5rem;
  font: inherit;
  cursor: pointer;
}

.spacing-explanation__edit:focus-visible {
  outline: 3px solid color(blue-300);
  outline-offset: 3px;
}
