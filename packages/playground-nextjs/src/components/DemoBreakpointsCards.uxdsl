.demo-breakpoints-cards {
  display: flex;
  flex-direction: xs(column) md(row);
  gap: space(4);
  padding: space(6);
  @ds-surface (light);
  border: 1px solid palette(surface-contrast);
  border-radius: radius(3);
  margin-bottom: space(8);
}

.demo-breakpoints-card-item {
  @ds-surface;
  flex: 1;
  padding: space(6);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: space(3);
  border: 1px solid palette(surface-dark);
  border-radius: radius(2);
  box-shadow: shadow(1);
}

.demo-breakpoints-card-title {
  font-weight: 600;
  color: palette(surface-contrast);
}

.demo-breakpoints-card-text {
  font-size: 0.875rem;
  color: palette(tertiary-dark);
}
