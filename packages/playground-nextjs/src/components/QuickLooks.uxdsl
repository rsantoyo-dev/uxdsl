/* The Live theme handler's quick looks (QuickLooks.tsx): dials, a font and brands, and one line
   under it, so the parts of the theme come right after. Every value is a UXDSL token, role or
   directive; the literals left are layout (flex). */

.qlk {
  @ds-surface(contained 2 radius(3));

  display: flex;
  flex-direction: column;
  gap: density(1);
  /* "Change it" in the page's head stops here, below the page's bars. */
  scroll-margin-top: space(12);
}

.qlk__looks {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(1) density(2);
}

.qlk__title {
  @ds-typo(subtitle2);

  display: inline-flex;
  align-items: center;
  gap: density(1);
  margin-inline-end: density(1);
  color: palette(text.primary);
}

.qlk__icon {
  flex: none;
  color: palette(primary.main);
}

/* A dial: its name, −, the level and +, in one pill. */
.qlk__dial {
  @ds-surface(outlined primary radius(pill));
  @ds-typo(caption);

  display: inline-flex;
  align-items: center;
  gap: density(0);
  padding: density(0) density(1) density(0) density(3);
  font-weight: 600;

  /* Off the level of the theme the page started from. */
  &.is-moved {
    background: palette(primary.main, 0.12);
  }
}

.qlk__dial-label {
  margin-inline-end: density(1);
}

.qlk__dial-step {
  @ds-button(flat primary 1 radius(pill));

  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: density(1);
}

.qlk__dial-value {
  @ds-typo(subtitle2);

  min-width: space(6);
  color: palette(text.primary);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

/* The font of the page: a pill like a dial, holding a list. */
.qlk__font {
  @ds-surface(outlined primary radius(pill));
  @ds-typo(caption);

  display: inline-flex;
  align-items: center;
  gap: density(1);
  padding: density(1) density(1) density(1) density(3);
  font-weight: 600;

  &.is-moved {
    background: palette(primary.main, 0.12);
  }
}

.qlk__font-select {
  @ds-input(outlined primary 1 radius(pill));
  @ds-typo(caption);

  width: auto;
  padding: density(0) density(1);
  border: border(0);
  color: palette(text.primary);
  font-weight: 700;
  cursor: pointer;
}

.qlk__look {
  @ds-button(outlined primary radius(pill));
  @ds-typo(caption);

  padding: density(1) density(3);
  font-weight: 600;
}

.qlk__reset {
  @ds-button(flat radius(pill));
  @ds-typo(caption);

  display: inline-flex;
  align-items: center;
  gap: density(1);
  padding: density(1) density(2);
}

.qlk__status {
  @ds-typo(caption);

  margin: density(0);
  color: palette(text.secondary);

  &.is-invalid {
    color: palette(error.main);
  }
}
