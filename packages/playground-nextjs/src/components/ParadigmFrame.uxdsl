/* The home page's resizable frame. Its geometry comes in as three custom properties set by the
   component (--frame-width, --frame-height, --frame-scale); the frame is drawn scaled, so its
   layout width — the width its media queries see — is --frame-width. */

.paradigm-frame {
  @ds-surface(outlined);
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) lg(minmax(0, 1fr) 15rem);
  align-items: start;
  gap: space(4);
  padding: density(3);
  background: palette(surface.light);
}

.paradigm-frame__main {
  display: grid;
  gap: space(2);
  min-width: 0;
}

.paradigm-frame__stage {
  position: relative;
  width: 100%;
  min-width: 0;
  touch-action: none;
}

.paradigm-frame__viewport {
  position: relative;
  width: calc(var(--frame-width) * var(--frame-scale));
  height: calc(var(--frame-height) * var(--frame-scale));
  border: border(1);
  border-radius: radius(1);
  overflow: hidden;
  background: palette(surface.main);
  box-shadow: shadow(1);
}

.paradigm-frame__iframe {
  display: block;
  border: 0;
  width: var(--frame-width);
  height: var(--frame-height);
  transform: scale(var(--frame-scale));
  transform-origin: 0 0;
  pointer-events: none;
}

/* The drag handle: the frame's right edge. */
.paradigm-frame__handle {
  position: absolute;
  top: 0;
  right: 0;
  width: space(5);
  height: 100%;
  cursor: ew-resize;
  background: linear-gradient(to right, transparent, palette(primary.main, 0.18));
  border-right: 3px solid palette(primary.main);

  &:hover {
    background: linear-gradient(to right, transparent, palette(primary.main, 0.3));
  }
}

.paradigm-frame__ticks {
  display: block;
  overflow: visible;
  color: palette(text.secondary);
  font-size: 11px;
  font-family: var(--uxdsl__font__code), monospace;

  & line {
    stroke: currentColor;
    stroke-width: 1;
  }

  & text {
    fill: currentColor;
  }
}

.paradigm-frame__tick.is-active {
  color: palette(primary.main);
  font-weight: 700;
}

.paradigm-frame__control {
  @ds-typo(caption);
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: space(4);
  margin: 0;
  color: palette(text.secondary);
}

.paradigm-frame__readout {
  display: grid;
  grid-template-columns: xs(repeat(2, minmax(0, 1fr))) md(repeat(4, minmax(0, 1fr))) lg(minmax(0, 1fr));
  gap: space(2);
  margin: 0;

  & > div {
    min-width: 0;
    padding: space(2) space(3);
    border-radius: radius(1);
    background: palette(surface.main);
    border: border(1);
  }

  & dt {
    @ds-typo(caption);
    margin: 0;
    color: palette(text.secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  & dd {
    @ds-typo(span);
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: palette(surface.contrast);
  }
}
