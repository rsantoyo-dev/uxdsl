/* Palette Playground Scoped Styles */
.module-root {
    height: 100%; /* MIG-B7-17 phase B (4): was inline style={{}} on the root */

    .playground-wrapper {
        display: flex;
        flex-direction: column;
        gap: density(3);
    }

    .playground-controls {
        display: flex;
        flex-wrap: wrap;
        gap: density(2);
        align-items: center;
        width: 100%;
    }

    .control-group {
        display: flex;
        flex-direction: column;
        gap: density(1);
        flex: 1;
        min-width: 140px;
    }

    .control-label {
        @ds-typo(caption);
        color: palette(neutral-dark);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .control-select {
        padding: density(1) density(2);
        border: 1px solid palette(neutral-light);
        border-radius: radius(1);
        background: palette(surface-main);
        color: palette(surface-contrast);
        font-size: 0.9rem;
        cursor: pointer;
        width: 100%;

        &:hover {
            border-color: palette(primary-main);
        }

        &:focus {
            outline: none;
            border-color: palette(primary-main);
            box-shadow: 0 0 0 2px palette(primary-main, 0.2);
        }
    }

    .preview-container {
        display: flex;
        flex-direction: column;
        gap: density(3);
        background: palette(surface-light);
        padding: density(3);
        border: 1px dashed palette(neutral-light);
        border-radius: radius(2);
    }

    .live-preview {
        /* These will be set inline by React, but we provide defaults */
        min-height: 120px;
        display: grid;
        place-items: center;
        border-radius: radius(2);
        box-shadow: shadow(1);
        transition: all 0.3s ease;
    }

    .code-block {
        @ds-surface(contained);
        background: palette(neutral-dark); /* Force dark background for code */
        border-radius: radius(2);
        overflow: hidden;
    }

    .code-header {
         background: palette(neutral-dark, 0.5); /* Slightly lighter than main bg */
         padding: density(1) density(2);
         border-bottom: 1px solid palette(neutral-main, 0.1);
    }

    .code-filename {
        @ds-typo(caption);
        font-family: monospace;
        color: palette(neutral-light);
    }

  /* MIG-B7-17 phase B (4): the toolbar, the preview's static half and the "CSS Usage" panel were
     inline style={{}} in PalettePlayground.tsx (the preview's two colors are chosen at runtime and
     stay inline). Values on the scale use space(), palette reads use palette(). */
  .pp-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: space(5);
    width: 100%;
  }

  .pp-toolbar__column {
    display: flex;
    flex-direction: column;
    gap: space(3);
    flex: 1 1 200px;
  }

  .pp-toolbar__heading {
    font-size: 0.75rem;
    font-weight: 600;
    color: palette(text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pp-toolbar__row {
    display: flex;
    gap: space(3);
  }

  .control-group.pp-toolbar__control {
    flex: 1;
  }

  .control-label.pp-toolbar__label {
    font-size: 0.7rem;
  }

  .control-select.pp-toolbar__select {
    padding: space(2);
    font-size: 0.8rem;
  }

  .live-preview.pp-preview {
    padding: space(4);
    text-align: center;
    font-weight: bold;
    font-size: 1.2rem;
  }

  .pp-usage {
    margin-top: space(6);
    padding: space(5);
    background: palette(surface-light);
    border: 1px solid palette(neutral-light);
    border-radius: 6px;
    text-align: left;
  }

  .pp-usage__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: space(3);
  }

  .pp-usage__title {
    font-size: 0.8rem;
    color: palette(text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pp-code {
    background: palette(surface-dark);
    padding: space(4);
    border-radius: 6px;
    font-family: var(--uxdsl__font__code);
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: space(2);
    overflow-x: auto;
    border: 1px solid palette(neutral-dark);
  }

  .pp-code__line {
    display: flex;
    align-items: center;
  }

  .pp-code__indent {
    padding-left: space(5);
  }

  .pp-code__selector {
    color: palette(secondary-light);
  }

  .pp-code__property {
    color: palette(primary-light);
  }

  .pp-code__function {
    color: palette(text-primary);
  }

  .pp-code__argument {
    color: palette(warning-light);
  }

  .pp-code__punct {
    color: palette(text-disabled);
  }

  .pp-code__gap {
    margin-left: space(3);
  }

  .pp-usage__note {
    margin-top: space(4);
    font-size: 0.8rem;
    color: palette(text-secondary);
    line-height: 1.5;
  }

  .pp-usage__note strong {
    color: palette(text-primary);
  }
}
