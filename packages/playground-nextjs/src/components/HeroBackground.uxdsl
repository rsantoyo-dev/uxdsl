.hero-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  border-radius: inherit;
  z-index: 0;
}

.hero-background__blob {
  position: absolute;
  left: 0;
  top: 0;
  border-radius: 50%;
  will-change: transform;
}

.hero-background__blob--secondary {
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, palette(secondary-main) 0%, transparent 60%);
  opacity: var(--blob-opacity, 0.05);
  filter: blur(80px);
}

.hero-background__blob--primary {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, palette(primary-main) 0%, transparent 60%);
  opacity: var(--blob-opacity, 0.08);
  filter: blur(60px);
}

.hero-background__blob--dark {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, palette(primary-dark) 0%, transparent 70%);
  opacity: 0; /* Controlled by JS */
  filter: blur(40px);
  mix-blend-mode: multiply;
}

.hero-background__overlay {
  position: absolute;
  inset: 0;
  backdrop-filter: blur(20px);
  opacity: 0.5;
}
