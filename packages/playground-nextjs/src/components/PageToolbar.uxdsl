/* PageToolbar styles - Scoped */
#PageToolbar {
  width: 100%;
  background: palette(surface-light);
  border-bottom: 1px solid palette(neutral-light);
  position: -webkit-sticky; /* Safari */
  position: sticky;
  top: 0;
  z-index: 1100; /* Higher than AppHeader (1000) to sit on top when stuck */
}

#PageToolbar .page-toolbar {
  max-width: 1400px;
  margin: 0 auto;
  padding: space(1) space(2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 40px; 
}

#PageToolbar .page-toolbar__left {
  display: flex;
  align-items: center;
  gap: density(2); /* Increased gap for better spacing */
}

#PageToolbar .page-toolbar__logo {
  width: 24px; /* Smaller as requested */
  height: 24px; /* Smaller as requested */
  display: block;
  flex-shrink: 0;
}

#PageToolbar .page-toolbar__title {
  @ds-typo(body-sm);
  color: palette(text-secondary);
  font-weight: 400; /* Not bold */
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  gap: density(1);
}

#PageToolbar .breadcrumb-link-brand {
  display: flex;
  align-items: center;
  gap: density(1);
  text-decoration: none;
  color: inherit; /* Inherit color from parent for brand consistency */
  font-weight: 800; /* Bold as requested */
  text-transform: uppercase; /* Uppercase as requested */
  letter-spacing: 0.5px; /* Slight letter spacing for branding */
  transition: transform 0.2s;

  &:hover {
    transform: translateY(-1px);
    color: palette(primary-main);
  }
}

#PageToolbar .page-toolbar__brand-text {
  color: palette(primary-main); /* Branded color */
  font-weight: 800; /* Ensure bold */
}

#PageToolbar .breadcrumb-link {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s;
  
  &:hover {
    color: palette(primary-main);
    text-decoration: underline;
  }
}

#PageToolbar .breadcrumb-separator {
  color: palette(neutral-dark);
  opacity: 0.5;
}

#PageToolbar .page-toolbar__left {
  display: flex;
  align-items: center;
  gap: density(1); /* Reduced gap */
}

#PageToolbar .page-toolbar__burger {
  background: transparent;
  border: none;
  color: palette(secondary-main);
  cursor: pointer;
  padding: 0; /* No padding */
  display: flex;
  align-items: center;
  justify-content: center;
  /* Removed border-radius */
  /* Removed transition */
}

#PageToolbar .page-toolbar__burger:hover {
  color: palette(secondary-dark); /* Only change color on hover */
  background: transparent;
}

@media (min-width: 1024px) {
  #PageToolbar .page-toolbar__burger {
    display: none;
  }
}

#PageToolbar .page-toolbar__right {
  display: flex;
  align-items: center;
  gap: space(2);
  @ds-typo(caption);
}

#PageToolbar .page-toolbar__bp {
  @ds-typo(caption);

  background: palette(secondary-light, 0.1);
  padding: density(2) density(3);
  border-radius: radius(1);
}

#PageToolbar .page-toolbar__width {
  @ds-typo(caption);
  opacity: 0.7;
}
