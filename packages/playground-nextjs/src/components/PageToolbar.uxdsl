/* PageToolbar styles - Scoped */
#PageToolbar {
  width: 100%;
  background: palette(surface-light);
  border-bottom: 1px solid palette(neutral-light);
  position: -webkit-sticky; /* Safari */
  position: sticky;
  top: 0;
  z-index: 1100; /* Higher than AppHeader (1000) to sit on top when stuck */
}

#PageToolbar .page-toolbar {
  max-width: 1400px;
  margin: 0 auto;
  padding: density(1) density(4); /* Thinner padding, strictly density */
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: density(10); /* Thinner height (approx 40px) */
}

#PageToolbar .page-toolbar__left {
  display: flex;
  align-items: center;
  gap: density(2);
}

#PageToolbar .page-toolbar__title {
  @ds-typo(body-sm);
  color: palette(text-secondary);
  font-weight: 400;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  gap: density(1);
}

#PageToolbar .breadcrumb-link-brand {
  text-decoration: none;
  color: inherit;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  gap: density(1); /* Ensure gap uses density if flex is active */

  &:hover {
    transform: translateY(-1px);
    color: palette(primary-main);
  }
}

#PageToolbar .page-toolbar__brand-text {
  color: palette(primary-main);
  font-weight: 800;
}

#PageToolbar .breadcrumb-link {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s;
  
  &:hover {
    color: palette(primary-main);
    text-decoration: underline;
  }
}

#PageToolbar .breadcrumb-separator {
  color: palette(neutral-dark);
  opacity: 0.5;
}

#PageToolbar .page-toolbar__burger {
  background: transparent;
  border: none;
  color: palette(secondary-main);
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

#PageToolbar .page-toolbar__burger:hover {
  color: palette(secondary-dark);
  background: transparent;
}

@media (min-width: 1024px) {
  #PageToolbar .page-toolbar__burger {
    display: none;
  }
}

/* Right Side - Row Layout */
#PageToolbar .page-toolbar__right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: density(4);
  @ds-typo(caption);
}

#PageToolbar .page-toolbar__info-row {
  display: flex;
  align-items: center;
  gap: density(4); /* Replaced space(2) with density(4) */
}

#PageToolbar .page-toolbar__theme-row {
  display: flex;
  align-items: center;
  gap: density(2);
  
  /* Transition State */
  opacity: 0;
  transform: translateX(10px);
  pointer-events: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

  &.visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
}

#PageToolbar .page-toolbar__bp {
  @ds-typo(caption);
  background: palette(secondary-light, 0.1);
  padding: density(1) density(2);
  border-radius: radius(1);
  line-height: 1;
}

#PageToolbar .page-toolbar__width {
  @ds-typo(caption);
  opacity: 0.7;
  line-height: 1;
}

/* Mini Theme Buttons */
#PageToolbar .mini-theme-btn {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,0.1); /* Subtle border for light mode */
  padding: 0;
  cursor: pointer;
  opacity: 0.5;
  transition: all 0.2s;

  &:hover, &.active {
    opacity: 1;
    transform: scale(1.2);
    border-color: palette(surface-contrast, 0.5);
  }

  &.default { background: #2C415C; }
  &.green { background: #15803D; }
  &.purple { background: #7b1fa2; }
}

#PageToolbar .mini-theme-toggle {
  width: 12px;
  height: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  color: palette(text-secondary);
  opacity: 0.7;
  transition: color 0.2s;

  &:hover {
    opacity: 1;
    color: palette(primary-main);
  }
}