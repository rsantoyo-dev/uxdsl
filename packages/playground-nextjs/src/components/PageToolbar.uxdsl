/* The sticky bar under the header: breadcrumb on the left; on the right, the viewport width
   and the theme breakpoint whose rules apply at it (a link to the Breakpoints page, with the
   explanation in its title), and compact theme controls once the header scrolls away. */

.page-toolbar {
  width: 100%;
  background: palette(surface.light);
  border-bottom: border(1);
  position: sticky;
  top: 0;
  z-index: 1100;
}

.page-toolbar__inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: space(2) xs(space(4)) md(space(6));
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: space(3);
  min-height: space(9);
}

.page-toolbar__left {
  display: flex;
  align-items: center;
  gap: space(3);
  flex: 1;
  min-width: 0;
}

.page-toolbar__title {
  @ds-typo(span);
  margin: 0;
  color: palette(text.secondary);
  display: flex;
  align-items: center;
  gap: space(2);
  white-space: nowrap;
  overflow: hidden;
  min-width: 0;
}

.breadcrumb-link-brand {
  text-decoration: none;
  color: inherit;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  border-radius: radius(1);

  &:hover {
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.page-toolbar__brand-text {
  color: palette(primary.main);
  font-weight: 800;
}

.breadcrumb-link {
  color: inherit;
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  border-radius: radius(1);

  &:hover {
    color: palette(primary.main);
    text-decoration: underline;
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }

  &[aria-current="page"] {
    color: palette(surface.contrast);
  }
}

.breadcrumb-separator {
  color: palette(text.secondary);
}

.page-toolbar__burger {
  background: transparent;
  border: border(1);
  border-radius: radius(1);
  color: palette(surface.contrast);
  cursor: pointer;
  padding: space(1);
  display: xs(flex) lg(none);
  align-items: center;
  justify-content: center;
  flex-shrink: 0;

  &:hover {
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.page-toolbar__right {
  display: flex;
  align-items: center;
  gap: space(4);
  flex-shrink: 0;
}

.page-toolbar__viewport {
  @ds-typo(caption);
  display: flex;
  align-items: center;
  gap: space(2);
  margin: 0;
  color: palette(text.secondary);
  text-decoration: none;
  border-radius: radius(1);

  &:hover {
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.page-toolbar__viewport-label {
  display: xs(none) md(inline);
}

.page-toolbar__width {
  font-variant-numeric: tabular-nums;
}

.page-toolbar__bp {
  background: palette(primary.main, 0.12);
  color: palette(surface.contrast);
  padding: space(1) space(3);
  border-radius: radius(pill);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.page-toolbar__theme-row {
  display: xs(none) sm(flex);
  align-items: center;
  gap: space(2);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, visibility 0.2s ease;

  &.is-visible {
    opacity: 1;
    visibility: visible;
  }
}

.mini-theme-btn {
  width: 16px;
  height: 16px;
  border-radius: radius(circle);
  border: 1px solid palette(divider.main);
  padding: 0;
  cursor: pointer;

  &.is-active {
    box-shadow: 0 0 0 2px palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.mini-theme-btn--default { background: color(purple.600); }
.mini-theme-btn--green { background: color(green.600); }
.mini-theme-btn--slate { background: color(slate.800); }

.mini-theme-toggle {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  color: palette(text.secondary);
  border-radius: radius(1);

  &:hover {
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}
