/* /docs/theme, the Live theme handler's page: a small head (the title, one line and the three
   steps as links), the handler, and the theme file's reference below it. Every value is a UXDSL
   token, role or directive; the literals left are layout (grid, flex) and the title's gradient. */

/* One column on a narrow window (title, line, steps); from lg the steps sit beside the title. */
.thp__head {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) lg(minmax(0, 1fr) auto);
  align-items: center;
  gap: density(1) density(4);
  padding-block: density(2) density(3);
}

.thp__title {
  @ds-typo(h3);

  grid-row: 1;
  grid-column: 1;
  margin: density(0);
  /* The same gradient as the other pages' title (PageTitle), at a smaller role. */
  background: linear-gradient(135deg, palette(primary.main) 0%, palette(primary.light) 50%, palette(secondary.main) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: palette(primary.main);
}

.thp__subtitle {
  @ds-typo(body);

  grid-row: 2;
  grid-column: 1 / -1;
  margin: density(0);
  color: palette(text.secondary);
}

.thp__nav {
  grid-row: xs(3) lg(1);
  grid-column: xs(1) lg(2);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: density(2) density(3);
}

.thp__steps {
  display: flex;
  flex-wrap: wrap;
  gap: density(2);
  margin: density(0);
  padding: density(0);
  list-style: none;
}

/* A step is a link to where it happens on the page. */
.thp__step {
  @ds-button(outlined primary radius(pill));
  @ds-typo(caption);

  display: inline-flex;
  align-items: center;
  gap: density(2);
  padding: density(1) density(3) density(1) density(1);
  font-weight: 600;
  text-decoration: none;
}

.thp__num {
  @ds-typo(caption);

  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: space(6);
  height: space(6);
  border-radius: radius(circle);
  background: palette(primary.main);
  color: palette(primary.contrast);
  font-weight: 700;
}

.thp__more {
  @ds-typo(caption);

  color: palette(primary.main);
  font-weight: 600;
  text-underline-offset: space(1);

  &:focus-visible {
    outline: space(1) solid palette(primary.main);
    outline-offset: space(1);
    border-radius: radius(1);
  }
}

/* The page's anchors stop under the fixed header. */
.thp__editor,
.thp__reference h2,
.thp__reference h3 {
  scroll-margin-top: space(11);
}

/* The reference starts a new part of the page. */
.thp__reference {
  margin-top: density(8);
  padding-top: density(4);
  border-top: border(1);
}
