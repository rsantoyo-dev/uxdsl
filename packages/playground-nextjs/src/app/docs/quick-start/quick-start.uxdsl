/* QuickStart styles - Scoped - Sober & Futuristic */
#QuickStartPage {
  .section {
    display: flex;
    flex-direction: column;
    gap: density(6);
    margin-bottom: density(6);
    margin-top: density(4);
  }

  .step-card {
    /* Minimalist container */
    @ds-surface(flat);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: density(3);
    position: relative;
    
    /* Futuristic left border marker */
    border-left: 2px solid palette(neutral-light);
    padding-left: density(4);
    transition: all 0.3s ease;
  }

  .step-card:hover {
    border-left-color: palette(primary-main);
  }

  .step-header {
    display: flex;
    align-items: baseline;
    gap: density(4);
  }

  .step-number {
    /* Sober typographic number */
    @ds-typo(h6);
    color: palette(secondary-main); /* Secondary accent */
    font-family: font(code);
    font-weight: 700; 
    line-height: 1;
  }

  .step-title {
    @ds-typo(h5);
    margin: 0;
    font-weight: 600;
    color: palette(surface-contrast);
    letter-spacing: -0.5px;
  }

  .step-desc {
    @ds-typo(body);
    color: palette(surface-contrast); /* Full contrast */
    font-weight: 400; /* Ensure it's not bold, standard body text */
    max-width: 60ch;
    margin: 0;
  }

  .info-box {
    @ds-surface(outlined neutral);
    padding: density(3);
    border-radius: radius(1);
    display: flex;
    gap: density(2);
    align-items: flex-start;
    background: palette(surface-light, 0.5);
    border: 1px dashed palette(neutral-main);
  }

  .info-icon {
    color: palette(primary-main);
    margin-top: 2px;
  }

  .info-text {
    @ds-typo(body-sm);
    margin: 0;
    color: palette(surface-contrast, 0.8);
  }
  
  .code-wrapper {
    margin-top: density(4);
    box-shadow: shadow(2);
  }

  .warning-blockquote {
    @ds-surface(outlined, warning);
    padding: density(4);
    border-radius: radius(1);
    margin-bottom: density(8);
    color: palette(text-primary);
  }

  /* MIG-B7-17 phase B (4): were inline style={{}} in page.mdx. #646cff is Vite's own brand color
     (another product's identity, not this theme's): kept literal on purpose. */
  .warning-blockquote__title {
    display: flex;
    align-items: center;
    gap: space(3);
    margin: 0;
    font-weight: 600;
  }

  .warning-blockquote__body {
    margin: space(3) 0 0 0;
    font-size: 0.9rem;
  }

  .step-title.integrations-title {
    margin-top: space(7);
    margin-bottom: space(5);
  }

  .integrations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: space(5);
    margin-bottom: 3rem;
  }

  .step-card.step-card--vite {
    border-left-color: #646cff;
  }

  .section-rule {
    border-color: palette(neutral-main);
    opacity: 0.3;
    margin: space(7) 0;
  }

  .section-rule--wide {
    margin: 3rem 0;
  }

  .inline-link {
    color: palette(primary-main);
    text-decoration: underline;
  }
}
