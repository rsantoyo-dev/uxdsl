/* Minimal app styles using only DS tokens + packs */
@import '../components/RussianDoll.uxdsl';


/* Component demo styles have been moved to colocated .uxdsl files */

/* Global Slider Styles */
input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 6px;
  background: palette(neutral.light);
  border-radius: radius(pill);
  outline: none;
  opacity: 0.8;
  transition: opacity .2s;
  cursor: pointer;
  margin: density(1) 0;
}

input[type="range"]:hover {
  opacity: 1;
}

/* MIG-B7-17 phase E: the rule above removes the native outline; the browser walk found every
   range slider reachable by Tab with no visible focus. Keyboard focus gets a ring again. */
input[type="range"]:focus-visible {
  opacity: 1;
  outline: 2px solid palette(primary.main);
  outline-offset: 4px;
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: radius(pill);
  background: palette(primary.main);
  cursor: pointer;
  transition: background .15s ease-in-out, transform .1s;
  border: 2px solid palette(surface.main);
  box-shadow: shadow(1);
}

input[type="range"]::-webkit-slider-thumb:hover {
  background: palette(primary.light);
  transform: scale(1.1);
}

input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: radius(pill);
  background: palette(primary.main);
  cursor: pointer;
  transition: background .15s ease-in-out, transform .1s;
  border: 2px solid palette(surface.main);
  box-shadow: shadow(1);
}

input[type="range"]::-moz-range-thumb:hover {
  background: palette(primary.light);
  transform: scale(1.1);
}

/* A full-width monospace textarea for the theme/JSON editors in the demos (DemoBorders,
   DemoButtons, DemoShadows, DemoSurfaces, InputDemo, BreakpointEditor). MIG-B7-17 phase B (4):
   was the same inline style={{}} in all six. */
.code-textarea {
  width: 100%;
  font-family: monospace;
}
