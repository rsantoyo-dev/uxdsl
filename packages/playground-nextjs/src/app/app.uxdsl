/* Side navigation */
/*
.side-nav { @ds-surface (flat); border: border(1, palette(neutral-dark, 0.15)); border-radius: radius(2); padding: space(3); }
.side-nav__section + .side-nav__section { margin-top: space(4); }
.side-nav__section-title { @ds-typo (h5); margin: 0 0 space(2) 0; }
.side-nav__list { list-style: none; margin: 0; padding: 0; display: grid; gap: space(1); }
.side-nav__link { @ds-typo (body); text-decoration: none; color: palette(surface-contrast, 0.8); padding: space(1) space(2); border-radius: radius(1); display: block; }
.side-nav__link:hover { background: palette(primary-light); opacity: 0.15; color: palette(primary-dark); }
.side-nav__link[aria-current="page"] { background: palette(primary-light); opacity: 0.25; color: palette(primary-dark); }
*/

