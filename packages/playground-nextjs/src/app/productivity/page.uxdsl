/* Productivity Page styles - Scoped */
#ProductivityPage {
  .back-link {
    @ds-typo(body-sm);
    color: palette(primary-main);
    text-decoration: none;
    font-weight: bold;
  }

  .back-link:hover {
    text-decoration: underline;
  }
}

/* MIG-B7-17 phase B (4): was inline style={{}} in app/productivity/page.tsx. */
#ProductivityPage .back-link-row {
  margin-bottom: space(5);
}
