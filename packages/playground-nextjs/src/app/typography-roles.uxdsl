/* Single opt-in gate for DS typography */
.ds-typo {
  font-family: var(--uxdsl__font__ui), sans-serif;
  color: inherit;
  margin-block-start: auto;
  margin-block-end: auto;

}

/* Element-aware rules (low specificity via :where) */
:where(h1).ds-typo { font-size: var(--uxdsl__typography__h1-font-size); font-weight: var(--uxdsl__typography__h1-font-weight, 700); font-family: var(--uxdsl__typography__h1-font-family, var(--uxdsl__font__ui)); line-height: var(--uxdsl__typography__h1-line-height); letter-spacing: var(--uxdsl__typography__h1-letter-spacing); text-transform: var(--uxdsl__typography__h1-text-transform, none); text-decoration: var(--uxdsl__typography__h1-text-decoration, none); font-style: var(--uxdsl__typography__h1-font-style, normal); margin-block-start: var(--uxdsl__typography__h1-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__h1-margin-block-end, auto); }
:where(h2).ds-typo { font-size: var(--uxdsl__typography__h2-font-size); font-weight: var(--uxdsl__typography__h2-font-weight, 700); font-family: var(--uxdsl__typography__h2-font-family, var(--uxdsl__font__ui)); line-height: var(--uxdsl__typography__h2-line-height); letter-spacing: var(--uxdsl__typography__h2-letter-spacing); text-transform: var(--uxdsl__typography__h2-text-transform, none); text-decoration: var(--uxdsl__typography__h2-text-decoration, none); font-style: var(--uxdsl__typography__h2-font-style, normal); margin-block-start: var(--uxdsl__typography__h2-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__h2-margin-block-end, auto); }
:where(h3).ds-typo { font-size: var(--uxdsl__typography__h3-font-size); font-weight: var(--uxdsl__typography__h3-font-weight, 600); font-family: var(--uxdsl__typography__h3-font-family, var(--uxdsl__font__ui)); line-height: var(--uxdsl__typography__h3-line-height); letter-spacing: var(--uxdsl__typography__h3-letter-spacing); text-transform: var(--uxdsl__typography__h3-text-transform, none); text-decoration: var(--uxdsl__typography__h3-text-decoration, none); font-style: var(--uxdsl__typography__h3-font-style, normal); margin-block-start: var(--uxdsl__typography__h3-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__h3-margin-block-end, auto); }
:where(h4).ds-typo { font-size: var(--uxdsl__typography__h4-font-size); font-weight: var(--uxdsl__typography__h4-font-weight, 600); font-family: var(--uxdsl__typography__h4-font-family, var(--uxdsl__font__ui)); line-height: var(--uxdsl__typography__h4-line-height); letter-spacing: var(--uxdsl__typography__h4-letter-spacing); text-transform: var(--uxdsl__typography__h4-text-transform, none); text-decoration: var(--uxdsl__typography__h4-text-decoration, none); font-style: var(--uxdsl__typography__h4-font-style, normal); margin-block-start: var(--uxdsl__typography__h4-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__h4-margin-block-end, auto); }
:where(h5).ds-typo { font-size: var(--uxdsl__typography__h5-font-size); font-weight: var(--uxdsl__typography__h5-font-weight, 600); font-family: var(--uxdsl__typography__h5-font-family, var(--uxdsl__font__ui-2, var(--uxdsl__font__ui))); line-height: var(--uxdsl__typography__h5-line-height); letter-spacing: var(--uxdsl__typography__h5-letter-spacing); text-transform: var(--uxdsl__typography__h5-text-transform, none); text-decoration: var(--uxdsl__typography__h5-text-decoration, none); font-style: var(--uxdsl__typography__h5-font-style, normal); margin-block-start: var(--uxdsl__typography__h5-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__h5-margin-block-end, auto); }
:where(h6).ds-typo { font-size: var(--uxdsl__typography__h6-font-size); font-weight: var(--uxdsl__typography__h6-font-weight, 600); font-family: var(--uxdsl__typography__h6-font-family, var(--uxdsl__font__ui-2, var(--uxdsl__font__ui))); line-height: var(--uxdsl__typography__h6-line-height); letter-spacing: var(--uxdsl__typography__h6-letter-spacing); text-transform: var(--uxdsl__typography__h6-text-transform, none); text-decoration: var(--uxdsl__typography__h6-text-decoration, none); font-style: var(--uxdsl__typography__h6-font-style, normal); margin-block-start: var(--uxdsl__typography__h6-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__h6-margin-block-end, auto); }

:where(p).ds-typo { font-size: var(--uxdsl__typography__p-font-size); line-height: var(--uxdsl__typography__p-line-height, normal); font-weight: var(--uxdsl__typography__p-font-weight, 400); font-family: var(--uxdsl__typography__p-font-family, var(--uxdsl__font__ui)); letter-spacing: var(--uxdsl__typography__p-letter-spacing); text-transform: var(--uxdsl__typography__p-text-transform, none); text-decoration: var(--uxdsl__typography__p-text-decoration, none); font-style: var(--uxdsl__typography__p-font-style, normal); margin-block-start: var(--uxdsl__typography__p-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__p-margin-block-end, auto); }
:where(span).ds-typo { font-size: var(--uxdsl__typography__span-font-size); font-weight: var(--uxdsl__typography__span-font-weight, 400); font-family: var(--uxdsl__typography__span-font-family, var(--uxdsl__font__ui)); line-height: var(--uxdsl__typography__span-line-height); letter-spacing: var(--uxdsl__typography__span-letter-spacing); text-transform: var(--uxdsl__typography__span-text-transform, none); text-decoration: var(--uxdsl__typography__span-text-decoration, none); font-style: var(--uxdsl__typography__span-font-style, normal); margin-block-start: var(--uxdsl__typography__span-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__span-margin-block-end, auto); }
:where(small).ds-typo { font-size: var(--uxdsl__typography__small-font-size); opacity: var(--uxdsl__typography__caption-opacity, 1); font-family: var(--uxdsl__typography__small-font-family, var(--uxdsl__font__ui-2, var(--uxdsl__font__ui))); line-height: var(--uxdsl__typography__small-line-height); letter-spacing: var(--uxdsl__typography__small-letter-spacing); text-transform: var(--uxdsl__typography__small-text-transform, none); text-decoration: var(--uxdsl__typography__small-text-decoration, none); font-style: var(--uxdsl__typography__small-font-style, normal); margin-block-start: var(--uxdsl__typography__small-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__small-margin-block-end, auto); }
:where(.caption).ds-typo, :where(caption).ds-typo { font-size: var(--uxdsl__typography__caption-font-size); opacity: var(--uxdsl__typography__caption-opacity, 0.8); font-family: var(--uxdsl__typography__caption-font-family, var(--uxdsl__font__ui-2, var(--uxdsl__font__ui))); line-height: var(--uxdsl__typography__caption-line-height); letter-spacing: var(--uxdsl__typography__caption-letter-spacing); text-transform: var(--uxdsl__typography__caption-text-transform, none); text-decoration: var(--uxdsl__typography__caption-text-decoration, none); font-style: var(--uxdsl__typography__caption-font-style, normal); margin-block-start: var(--uxdsl__typography__caption-margin-block-start, auto); margin-block-end: var(--uxdsl__typography__caption-margin-block-end, auto); }
:where(pre).ds-typo, :where(code).ds-typo { font-family: var(--uxdsl__typography__pre-font-family, var(--uxdsl__font__code)), monospace; font-size: var(--uxdsl__typography__pre-font-size); line-height: var(--uxdsl__typography__pre-line-height); }

/* Attribute fallback for non-semantic tags */
.ds-typo[data-typo="h1"] { @ds-typo(h1); }
.ds-typo[data-typo="h2"] { @ds-typo(h2); }
.ds-typo[data-typo="h3"] { @ds-typo(h3); }
.ds-typo[data-typo="h4"] { @ds-typo(h4); }
.ds-typo[data-typo="h5"] { @ds-typo(h5); }
.ds-typo[data-typo="h6"] { @ds-typo(h6); }
.ds-typo[data-typo="p"] { @ds-typo(p); }
.ds-typo[data-typo="body"] { @ds-typo(body); }
.ds-typo[data-typo="span"] { @ds-typo(span); }
.ds-typo[data-typo="small"] { @ds-typo(small); }
.ds-typo[data-typo="caption"] { @ds-typo(caption); }
.ds-typo[data-typo="pre"] { @ds-typo(pre); }
.ds-typo[data-typo="code"] { @ds-typo(code); }
.ds-typo[data-typo="default"] { @ds-typo(default); }
