/* The home page. Above the fold on a laptop: the thesis, the example next to its compiled CSS,
   the resizable frame and the three ways in. */

.home {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - space(12));
  width: 100%;
}

.home-hero {
  box-sizing: border-box;
  width: 100%;
  max-width: 1320px;
  margin: 0 auto;
  padding: density(5) xs(space(4)) md(space(6));
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) lg(minmax(0, 5fr) minmax(0, 7fr));
  gap: density(4) density(6);
  align-items: start;
}

.home-hero__intro {
  display: grid;
  gap: density(3);
  min-width: 0;
}

.home-hero__eyebrow {
  @ds-typo(caption);
  margin: 0;
  color: palette(primary.main);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.home-hero__title {
  @ds-typo(h2);
  margin: 0;
  color: palette(surface.contrast);
  letter-spacing: -0.02em;
}

.home-hero__lede {
  @ds-typo(p);
  margin: 0;
  color: palette(text.secondary);
}

.home-hero__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: space(3);
}

.home-cta {
  @ds-button(outlined primary);
  display: inline-flex;
  align-items: center;
  gap: space(2);
  text-decoration: none;
  font-weight: 600;
}

.home-cta--primary {
  @ds-button(contained primary);
}

.home-hero__code {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) md(minmax(0, 1fr) minmax(0, 1fr));
  gap: space(4);
  min-width: 0;
}

.home-code {
  display: grid;
  align-content: start;
  gap: space(2);
  min-width: 0;
}

.home-code__label {
  @ds-typo(caption);
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: space(2);
  font-weight: 700;
  color: palette(surface.contrast);
}

.home-code__path {
  font-weight: 400;
  color: palette(text.secondary);
  font-family: var(--uxdsl__font__code), monospace;
}

/* Code on the home page is denser than in the documentation. */
.home-code .code-block-frame {
  font-size: 0.78rem;
}

/* The compiled CSS is longer than the source: it scrolls inside the panel. */
.home-code__scroll {
  max-height: xs(18rem) lg(19.5rem);
  overflow-y: auto;
  border-radius: radius(2);

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.home-hero__frame {
  grid-column: 1 / -1;
  display: grid;
  gap: space(2);
  min-width: 0;
}

.home-hero__frame-hint {
  @ds-typo(caption);
  margin: 0;
  color: palette(text.secondary);
}

.home-section-title {
  @ds-typo(h3);
  margin: 0 0 density(4);
}

.home-pillars {
  width: 100%;
  max-width: 1320px;
  margin: 0 auto;
  box-sizing: border-box;
  padding: density(8) xs(space(4)) md(space(6)) density(4);
}

.home-pillars__grid {
  display: grid;
  grid-template-columns: xs(minmax(0, 1fr)) md(repeat(2, minmax(0, 1fr))) xl(repeat(4, minmax(0, 1fr)));
  gap: density(4);
}

.home-pillar {
  @ds-surface(outlined);
  display: grid;
  align-content: start;
  gap: space(3);
  color: palette(surface.contrast);
  text-decoration: none;

  &:hover {
    border-color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.home-pillar__title {
  @ds-typo(h5);
  margin: 0;
  color: palette(primary.main);
}

.home-pillar__text {
  @ds-typo(span);
  margin: 0;
  color: palette(text.secondary);
}

.home-experiment {
  width: 100%;
  max-width: 1320px;
  margin: 0 auto;
  box-sizing: border-box;
  padding: density(6) xs(space(4)) md(space(6)) density(8);
  display: grid;
  justify-items: start;
}

.home-experiment__text {
  @ds-typo(span);
  margin: 0;
  max-width: 48rem;
  color: palette(text.secondary);
}

.home-footer {
  margin-top: auto;
  padding: density(6) space(4);
  background: palette(surface.light);
  border-top: border(1);
  display: grid;
  justify-items: center;
  gap: space(4);
  width: 100%;
}

.home-footer__links {
  display: flex;
  gap: space(6);
  flex-wrap: wrap;
  justify-content: center;
}

.home-footer__link {
  display: inline-flex;
  align-items: center;
  gap: space(2);
  color: palette(text.secondary);
  text-decoration: none;
  font-weight: 500;
  border-radius: radius(1);

  &:hover {
    color: palette(primary.main);
  }

  &:focus-visible {
    outline: 2px solid palette(primary.main);
    outline-offset: 2px;
  }
}

.home-footer__copy {
  @ds-typo(caption);
  margin: 0;
  color: palette(text.secondary);
}
