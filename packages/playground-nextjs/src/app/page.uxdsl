/* Welcome Page Styles */
#WelcomePage {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 64px); /* Adjust based on header height */
  width: 100%;

  .hero-surface {
    @ds-surface (contained);
    width: 100%;
    flex: 1;
    display: grid;
    place-items: center;
    background: palette(surface-light);
    border-bottom: border(1);
    padding: density(8);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: density(4);
    text-align: center;
  }

  .logo-container {
    width: density(32);
    height: density(32);
    display: grid;
    place-items: center;
    
    /* Optional: Add a glow or shadow to the logo container */
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1));
  }

  .hero-logo {
    width: 100%;
    height: auto;
  }

  .welcome-page-title {
    margin-bottom: 0;
    
    .page-title__text {
      font-size: 5rem;
      line-height: 1.1;
      font-weight: 900;
      letter-spacing: -0.03em;
      background: linear-gradient(135deg, palette(primary-dark), palette(primary-main));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: density(2);
    }

    .page-title__subtitle {
      font-size: 1.5rem;
      color: palette(text-secondary);
      font-weight: 500;
    }
  }

  .content-container {
    padding: density(6) density(4) density(10);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: density(4);
    background: palette(surface-main);
    flex: 0 0 auto;
  }

  .actions {
    margin-top: 0;
  }

  .get-started-btn {
    @ds-button (contained primary large);
    display: inline-flex;
    align-items: center;
    gap: density(2);
    padding-left: density(6);
    padding-right: density(6);
    font-weight: 600;
    border-radius: radius(full);
    transition: transform 0.2s;

    &:hover {
      transform: translateY(-2px);
      box-shadow: shadow(4);
    }
  }

  .intro-section {
    max-width: 600px;
    margin: density(4) 0;
  }

  .intro-text {
    @ds-typo (body);
    font-size: 1.125rem;
    line-height: 1.6;
    color: palette(text-secondary);
    text-align: center;
  }

  .demo-section {
    width: 100%;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: density(4);
    margin-top: density(4);
  }

  .section-label {
    @ds-typo (h6);
    color: palette(text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
  }

  .demo-wrapper-scale {
    width: 100%;
    /* Optional: Scale down slightly if it feels too big for the welcome page */
    /* transform: scale(0.9); */
  }

  .welcome-footer {
    margin-top: auto;
    padding: density(8) density(4);
    background: palette(surface-light);
    border-top: border(1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: density(4);
    width: 100%;
  }

  .footer-links {
    display: flex;
    gap: density(6);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: density(2);
    color: palette(text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;

    &:hover {
      color: palette(primary-main);
    }
  }

  .footer-copy {
    @ds-typo (caption);
    color: palette(text-disabled);
  }
}
