/* Welcome Page Styles */
#WelcomePage {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 64px); /* Adjust based on header height */
  width: 100%;

  .hero-surface {
    @ds-surface (contained);
    width: 100%;
    flex: 1;
    display: grid;
    place-items: center;
    gap: density(8);
    background: transparent;
    border-bottom: border(1);
    padding: density(8);
  }

  .hero-content {
    display: flex;
    flex-direction: column; /* Default to column on mobile */
    align-items: center;
    gap: density(4);
    text-align: center;

    @media (min-width: 768px) { /* On larger screens, switch to row */
      flex-direction: row;
      justify-content: center; /* Center the row content */
      text-align: left; /* Align text within the content to the left */
      
      .welcome-page-title {
        .page-title__text {
          margin-bottom: 0; /* Remove bottom margin when in row layout */
        }
      }
    }
  }

  .logo-container {
    width: density(30); /* Changed from density(32) to density(30) */
    height: density(30); /* Changed from density(32) to density(30) */
    display: grid;
    place-items: center;
    
    /* Optional: Add a glow or shadow to the logo container */
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1));
  }

  .hero-logo {
    width: 100%;
    height: auto;
  }

  .welcome-page-title {
    margin-bottom: 0;
    
    .page-title__text {
      @ds-typo (h1);
      background: linear-gradient(135deg, palette(primary-dark), palette(primary-main));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: density(2);
    }

    .page-title__subtitle {
      @ds-typo(h3);
      color: palette(text-secondary);
    }
  }

  .home-container {
    box-sizing: border-box;
    max-width: 90vw;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: density(6); /* Increased gap for better rhythm than density(2) for main sections */
    padding: density(8) density(4) density(10); /* Added top padding */
  }

  .actions {
    margin-top: 0;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .get-started-btn {
    @ds-button (contained primary large);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: density(2);
    padding: density(4) density(6);
    border-radius: radius(full);
    transition: transform 0.2s;
    width: 100%; 
    /* Removed max-width to allow full width on all screens as requested */

    &:hover {
      transform: translateY(-2px);
      box-shadow: shadow(4);
    }
  }

  .intro-section {
    width: 100%;
    /* max-width: 800px;  Optional: constrain text width for readability if needed, but user asked for full available */
    margin: 0;
  }

  .intro-text {
    @ds-typo (body);
    color: palette(text-secondary);
    text-align: center;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: density(4);
    width: 100%;
    max-width: 100%;
    margin-top: density(2);
    margin-bottom: density(2);
    box-sizing: border-box;

    @media (min-width: 768px) {
      grid-template-columns: repeat(2, 1fr);
    }


  }

  .demo-section {
    width: 100%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: density(4);
    margin-top: density(4);
  }

  .section-label {
    @ds-typo (h6);
    color: palette(text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .demo-wrapper-scale {
    width: 100%;
    /* Optional: Scale down slightly if it feels too big for the welcome page */
    /* transform: scale(0.9); */
  }

  .welcome-footer {
    margin-top: auto;
    padding: density(8) density(4);
    background: palette(surface-light);
    border-top: border(1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: density(4);
    width: 100%;
  }

  .footer-links {
    display: flex;
    gap: density(6);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: density(2);
    color: palette(text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;

    &:hover {
      color: palette(primary-main);
    }
  }

  .footer-copy {
    @ds-typo (caption);
    color: palette(text-disabled);
  }
}
