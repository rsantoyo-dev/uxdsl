/* Global layout primitives for Next.js app */

*, *::before, *::after { box-sizing: border-box; }

html, body { 
  min-height: 100%; 
  margin: 0 !important; 
  padding: 0 !important; 
  width: 100%;
  font-family: var(--uxdsl__font__ui, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  background: palette(surface-main);
  color: palette(surface-contrast);
  /* overflow-x: hidden; Removed to fix sticky positioning context */
}

.main {
  display: block;
  min-height: 100vh;
  padding: space(6) space(4);
  background: palette(surface-light);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: space(3);
}

/* Responsive Layout Grid */
.layout {
  display: grid;
  /* Mobile: Stacked (Nav is just a button), Desktop: Sidebar + Content */
  grid-template-columns: xs(100%) lg(max-content 1fr);
  gap: xs(space(4)) md(space(6));
  padding: xs(space(2)) md(space(4));
  margin: 0 auto;
  max-width: 1400px;
  align-items: start; /* Ensure sidebar stays at top, not centered */
}

.layout__nav {
  /* Mobile: remove from flow to prevent grid gap/spacing. Desktop (lg): restore to grid flow. */
  position: xs(absolute) lg(static);
  width: xs(0) lg(auto);
  height: xs(0) lg(auto);
  min-width: xs(auto) lg(0);
}

.layout__content {
  min-width: 0;
}
