/* Global layout primitives for Next.js app */

*, *::before, *::after { box-sizing: border-box; }

html, body { min-height: 100%; }
body {
  margin: 0;
  font-family: var(--font-ui, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  background: palette(surface-main);
  color: palette(surface-contrast);
}

.main {
  display: block;
  min-height: 100vh;
  padding: space(6) space(4);
  background: palette(surface-light);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: space(6);
}

/* Responsive Layout Grid */
.layout {
  display: grid;
  /* Mobile: Stacked (Nav is just a button), Desktop: Sidebar + Content */
  grid-template-columns: xs(100%) lg(max-content 1fr);
  gap: xs(space(4)) md(space(6));
  padding: xs(space(2)) md(space(4));
  margin: 0 auto;
  max-width: 1400px;
}

.layout__nav {
  /* Ensure nav doesn't collapse */
  min-width: 0;
}

.layout__content {
  min-width: 0;
}
