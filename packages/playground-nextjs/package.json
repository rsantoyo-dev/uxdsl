{
  "name": "uxdsl-playground-nextjs",
  "version": "0.0.6",
  "private": true,
  "scripts": {
    "local-deps": "npm install --prefix ../uxdsl-cli && npm install --prefix ../postcss-uxdsl && npm run build --prefix ../postcss-uxdsl",
    "uxdsl:build": "node scripts/generate-uxdsl-entry.js && uxdsl build",
    "uxdsl:watch": "node scripts/generate-uxdsl-entry.js && uxdsl build --watch",
    "dev": "npm run local-deps && npm run uxdsl:build && concurrently \"next dev\"",
    "build": "npm run local-deps && npm run uxdsl:build && next build",
    "start": "next start",
    "lint": "next lint",
    "stylelint": "stylelint \"src/**/*.uxdsl\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.uxdsl\" --fix --allow-empty-input",
    "postinstall": "npm run local-deps"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.5",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.6.0",
    "@vercel/speed-insights": "^1.3.0",
    "lucide-react": "^0.554.0",
    "next": "^14.0.0",
    "postcss": "^8.5.6",
    "postcss-uxdsl": "file:../postcss-uxdsl",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-syntax-highlighter": "^16.1.0",
    "sass": "^1.94.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "postcss-loader": "^8.2.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "typescript": "^5.0.0",
    "uxdsl-cli": "file:../uxdsl-cli"
  }
}
