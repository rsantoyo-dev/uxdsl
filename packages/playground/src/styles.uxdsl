@import "./theme-def.uxdsl";
@import "./mixins.uxdsl";

/* Standard CSS compatible with the plugin's substitution */
*,
*::before,
*::after {
  box-sizing: border-box;
}
html,
body,
#root {
  width: 100%;
}
code,
pre {
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
img,
video,
svg {
  max-width: 100%;
  height: auto;
}

body {
  display: grid;
  padding: xs(space(2)) md(space(4));
  background: palette(light-main);
  color: color(purple.300);
  color-scheme: light dark;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto,
    Helvetica, Arial, Noto Sans, "Apple Color Emoji", "Segoe UI Emoji";
  /* Avoid accidental horizontal scroll during resize */
  overflow-x: hidden;
}

.hello {
  background-color: palette(primary-light);
  padding: xs(space(2)) md(space(4));
  font-weight: 600;
  letter-spacing: 0.25px;
}

.app {
  box-sizing: border-box;
  max-width: 1040px;
  width: 100%;
  margin: 0 auto;
  padding: xs(space(5)) md(space(8));
  min-width: 0; /* allow children to shrink */
  overflow-wrap: anywhere; /* avoid overflow from long tokens */
}

.toolbar {
  display: flex;
  gap: 8px;
  align-items: center;
  margin: 8px 0 12px;
  /* Prevent horizontal overflow on small screens */
  flex-wrap: wrap;
  min-width: 0;
}

.toolbar label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.grid {
  display: grid;
  /* Flexible columns that won’t overflow when resizing */
  grid-template-columns: xs(1fr) lg(repeat(auto-fit, minmax(240px, 1fr)));
  gap: xs(12px) lg(16px);
  align-items: stretch;
  /* Allow content to shrink and avoid overflow */
  min-width: 0;
}

/* Responsive showcase demonstrating multiple properties */
.showcase {
  display: flex;
  flex-direction: xs(column) md(row);
  gap: xs(8px) lg(16px);
  align-items: stretch;
  margin: 12px 0 16px;
  min-width: 0;
}

.showcase__box {
  flex: 1 1 0%;
  background: xs(palette(light-main)) md(palette(tertiary-light))
    lg(palette(primary-light));
  color: palette(surface-contrast);
  padding: var(--pad2-density-2);
  border-radius: xs($radius-md) lg($radius-md);
  box-shadow: $shadow-soft;
  min-width: 0;
}

.showcase__stack {
  display: flex;
  flex-direction: xs(column) md(row);
  gap: xs(6px) lg(12px);
  flex-wrap: wrap;
  margin: 8px 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  background: xs(palette(primary-light)) lg(palette(primary-dark));
  color: palette(primary-contrast);
  border-radius: xs($radius-md) md($radius-pill);
  padding: var(--pad2-density-1);
  font-weight: 600;
  letter-spacing: 0.25px;
}

.vis {
  font-size: 0.9rem;
  opacity: 0.9;
}
.vis--mobile {
  display: xs(block) lg(none);
}
.vis--desktop {
  display: xs(none) lg(block);
}

.cta {
  margin-top: 8px;
  display: inline-block;
  background: palette(primary-main);
  color: palette(primary-contrast);
  border: none;
  border-radius: $radius-md;
  padding: var(--pad2-density-3);
  font-size: xs(14px) md(16px) lg(18px);
  cursor: pointer;
}

.showcase__box--grad {
  background: xs(palette(light-main))
    md(linear-gradient(135deg, palette(primary-light), palette(tertiary-light)));
  filter: xs(none) md(saturate(1.05)) lg(saturate(1.1) brightness(1.03));
}

.cta:hover {
  filter: brightness(0.95);
}

/* Card-specific styles moved to components/Card.uxdsl */
