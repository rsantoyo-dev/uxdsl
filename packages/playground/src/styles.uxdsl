

@import './theme-def.uxdsl';

/* Standard CSS compatible with the plugin's substitution */
body {
  display: grid;
  padding: xs(6px) lg(20px);
  margin: 0;
  background: theme(light-main);
  color: theme(light-contrast);
  color-scheme: light dark;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Noto Sans,
    'Apple Color Emoji', 'Segoe UI Emoji';
  /* Avoid accidental horizontal scroll during resize */
  overflow-x: hidden;
}

.hello {
  font-weight: 600;
  letter-spacing: 0.25px;
}

.app {
  box-sizing: border-box;
  max-width: 1040px;
  width: 100%;
  margin: 0 auto;
  padding: xs(12px) lg(24px);
}

.toolbar {
  display: flex;
  gap: 8px;
  align-items: center;
  margin: 8px 0 12px;
}

.toolbar label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.grid {
  display: grid;
  /* Flexible columns that won’t overflow when resizing */
  grid-template-columns: xs(1fr) lg(repeat(auto-fit, minmax(240px, 1fr)));
  gap: xs(12px) lg(16px);
  align-items: stretch;
}

/* Card-specific styles moved to components/Card.uxdsl */
