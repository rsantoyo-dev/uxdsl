@import "../mixins.uxdsl";

.demo-inputs {
  display: grid;
  gap: density(2);
}

.demo-inputs__controls {
  display: flex;
  align-items: center;
  gap: density(2);
}

.demo-inputs__row {
  display: grid;
  grid-template-columns: repeat(3, minmax(200px, 1fr));
  gap: density(2);
}

.input.input--contained { @ds-input (contained); }
.input.input--outlined { @ds-input (outlined); }
.input.input--underline { @ds-input (underline); }

.input.input--contained.input--secondary { @ds-input (contained secondary); }
.input.input--outlined.input--secondary { @ds-input (outlined secondary); }
.input.input--underline.input--secondary { @ds-input (underline secondary); }

// SCSS example: mixin for size adjustment
@mixin input-size($n) {
  padding: density($n);
  border-radius: radius($n);
}

.input.input--sass-2 { @ds-input (underline tertiary 2); @include input-size(2); }
