@import "../mixins.uxdsl";

.demo-spacing h2 { @ds-typo(h2); }
.demo-spacing h3 { @ds-typo(h3); }
.demo-spacing small { @ds-typo(small); }

.space-grid {
  display: grid;
  grid-template-columns: xs(1fr) md(repeat(auto-fit, minmax(160px, 1fr)));
  gap: xs(space(3)) md(space(4));
}

.space-box {
  background: palette(primary-light);
  color: palette(primary-contrast);
  border-radius: radius(1);
}

.space-1 { padding: space(1); }
.space-2 { padding: space(2); }
.space-3 { padding: space(3); }
.space-4 { padding: space(4); }
.space-5 { padding: space(5); }
.space-6 { padding: space(6); }

.density-box {
  background: palette(primary-main);
  color: palette(primary-contrast);
  border-radius: radius(1);
}

.density-1 { padding: density(1); }
.density-2 { padding: density(2); }
.density-3 { padding: density(3); }

.gap-demo {
  display: flex;
  flex-wrap: wrap;
  gap: densities(1, 2, 3);
  background: palette(primary-dark);
  color: palette(primary-contrast);
  padding: density(1);
  border-radius: radius(1);
}

.gap-item {
  background: palette(primary-light);
  color: palette(primary-contrast);
  padding: space(2);
  border-radius: radius(1);
}

