@import "../mixins.uxdsl";

.demo-typography {
  display: grid;
}

.demo-typography .card {
  @ds-surface;
}

.demo-typography .card-content {
  display: grid;
}

/* Apply DS typography to semantic tags inside the demo scope */
.demo-typography h1 {
  @ds-typo (h1);
}
.demo-typography h2 {
  @ds-typo (h2);
}
.demo-typography h3 {
  @ds-typo (h3);
}
.demo-typography h4 {
  @ds-typo (h4);
}
.demo-typography h5 {
  @ds-typo (h5);
}
.demo-typography h6 {
  @ds-typo (h6);
}
.demo-typography p {
  @ds-typo (p);
}
.demo-typography span {
  @ds-typo (span);
}
.demo-typography small {
  @ds-typo (small);
}
.demo-typography pre,
.demo-typography code {
  @ds-typo (pre);
}
.demo-typography .caption {
  @ds-typo (caption);
}

.demo-typography__list {
  display: grid;
  gap: density(2);
  padding: density(2);
}

.demo-typography__item {
  display: grid;
  gap: density(2);
}

.demo-typography__meta {
  opacity: 0.85;
}

.demo-typography__row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: density(2);
}

.demo-typography__stack {
  display: grid;
  gap: density(2);
}
