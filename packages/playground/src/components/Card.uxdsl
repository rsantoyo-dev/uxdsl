@import "../mixins.uxdsl";

.card {
  padding: xs(space(2)) md(space(4));
  color: palette(primary-contrast);
  /* Make large lists smooth without JS: */
  content-visibility: auto;
  contain-intrinsic-size: 140px; /* reserve vertical space for off-screen cards */
  min-width: 0; /* prevent inline overflow */
}

.card--light {
  background: palette(primary-light);
}
.card--main {
  background: palette(primary-main);
}
.card--dark {
  background: palette(primary-dark);
}

.card__title {
  margin: 0 0 8px 0;
  font-size: xs(20px) lg(30px);
}

.card__meta {
  margin: 0;
  opacity: 0.9;
  font-size: 0.9rem;
}
