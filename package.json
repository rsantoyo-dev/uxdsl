{
  "name": "uxdsl",
  "version": "1.0.0",
  "description": "This repo contains a minimal UX-focused CSS dialect (UXDSL) and tooling to load it in a Vite + React app.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "verify:docs": "node scripts/verify-docs-update.js",
    "release:patch": "node scripts/release.js --bump patch",
    "release:minor": "node scripts/release.js --bump minor",
    "release:major": "node scripts/release.js --bump major",
    "release:patch:bump-only": "node scripts/release.js --bump patch --skip-publish",
    "release:minor:bump-only": "node scripts/release.js --bump minor --skip-publish",
    "release:major:bump-only": "node scripts/release.js --bump major --skip-publish",
    "theme:audit": "npm --prefix packages/playground-nextjs run theme:audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
